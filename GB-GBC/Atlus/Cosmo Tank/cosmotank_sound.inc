; Cosmo Tank sound driver (Atlus / Tsukasa Masuko): definitions and data macros
; generated by tools/gen_ct.py

; ---- hardware ----
DEF rNR10 EQU $FF10
DEF rNR11 EQU $FF11
DEF rNR12 EQU $FF12
DEF rNR13 EQU $FF13
DEF rNR14 EQU $FF14
DEF rNR21 EQU $FF16
DEF rNR22 EQU $FF17
DEF rNR23 EQU $FF18
DEF rNR24 EQU $FF19
DEF rNR30 EQU $FF1A
DEF rNR31 EQU $FF1B
DEF rNR32 EQU $FF1C
DEF rNR33 EQU $FF1D
DEF rNR34 EQU $FF1E
DEF rNR41 EQU $FF20
DEF rNR42 EQU $FF21
DEF rNR43 EQU $FF22
DEF rNR44 EQU $FF23
DEF rNR50 EQU $FF24
DEF rNR51 EQU $FF25
DEF rNR52 EQU $FF26
DEF _AUD3WAVERAM EQU $FF30

; ---- track record (16 bytes at wTracks + 16 * track) ----
DEF TRK_FLAGS     EQU $00 ; b0 active, b1 resting (never read), b2 sweep on (track 0), b7 muted by SFX
DEF TRK_TIMER     EQU $01 ; frames until the next event
DEF TRK_ENVCOUNT  EQU $02 ; frames until the next envelope step
DEF TRK_ENVPOS    EQU $03 ; 2: envelope position (NRx2 byte of the current pair)
DEF TRK_ATTEN     EQU $05 ; $F2: subtracted from every NRx2 value
DEF TRK_FINE      EQU $06 ; $F9: added to the period
DEF TRK_TRANSPOSE EQU $07 ; $F3: semitones
DEF TRK_PTR       EQU $08 ; 2: stream pointer (points at the last byte read)
DEF TRK_LENGTH    EQU $0A ; $80-$BF: frames per note/rest
DEF TRK_NRX1      EQU $0B ; $F1: NRx1 (duty / CH3 length)
DEF TRK_PERIOD    EQU $0C ; 2: NRx3, NRx4 (bit 7 = trigger); CH4: NR43, $80
DEF TRK_ENV       EQU $0E ; 2: $F0: envelope of new notes

; ---- notes ----
DEF __n = 0
FOR __o, 2, 9
	DEF C_{d:__o} EQU __n
	DEF Cs{d:__o} EQU __n + 1
	DEF D_{d:__o} EQU __n + 2
	DEF Ds{d:__o} EQU __n + 3
	DEF E_{d:__o} EQU __n + 4
	DEF F_{d:__o} EQU __n + 5
	DEF Fs{d:__o} EQU __n + 6
	DEF G_{d:__o} EQU __n + 7
	DEF Gs{d:__o} EQU __n + 8
	DEF A_{d:__o} EQU __n + 9
	DEF As{d:__o} EQU __n + 10
	DEF B_{d:__o} EQU __n + 11
	DEF __n += 12
ENDR
DEF REST EQU $54

DEF PAN_C EQU $00 ; both sides
DEF PAN_R EQU $04 ; SO1 only
DEF PAN_L EQU $08 ; SO2 only

; ---- headers ----
MACRO track ; track number (0-3 music, 4-7 SFX), first event
	db \1
	dw \2 - 1 ; the driver pre-increments
ENDM
MACRO hdr_end
	db $FF
ENDM

; ---- envelope step ----
MACRO env_step ; frames (0 = 256), NRx2
	db \1, \2
ENDM

; ---- events ----
MACRO note ; C_2 .. B_8
	ASSERT (\1) < REST
	db \1
ENDM
MACRO noise ; NR43 value (stored nibble-swapped)
	db LOW((\1) << 4) | ((\1) >> 4)
ENDM
MACRO rest
	db REST
ENDM
MACRO len ; LengthTable index 0-$3F
	db $80 | (\1)
ENDM
MACRO pan ; PanTable index 0-$1F
	db $C0 | (\1)
ENDM
MACRO env
	db $F0, \1
ENDM
MACRO duty
	db $F1, \1
ENDM
MACRO atten
	db $F2, \1
ENDM
MACRO transpose
	db $F3, LOW(\1)
ENDM
MACRO loop_start ; body plays n times (0 = 256)
	db $F4, \1
ENDM
MACRO loop_end
	db $F5
ENDM
MACRO seq_call
	db $F6
	dw \1
ENDM
MACRO seq_ret
	db $F7
ENDM
MACRO seq_jump
	db $F8
	dw \1
ENDM
MACRO fine
	db $F9, \1
ENDM
MACRO sweep
	db $FA, \1
ENDM
MACRO sweep_off
	db $FB
ENDM
MACRO wave
	db $FC
	dw \1
ENDM
MACRO seq_end_d ; same handler as $FF
	db $FD
ENDM
MACRO seq_nop
	db $FE
ENDM
MACRO seq_end
	db $FF
ENDM

; ---- WRAM ($DF00-$DFC7) ----
DEF wTracks          EQU $DF00 ; 128 bytes: 8 tracks x 16 bytes (0-3 music CH1-CH4, 4-7 SFX CH1-CH4)
DEF wSndQueueCount   EQU $DF80 ;   1 bytes: number of queued ids (rst $30 adds, max 4)
DEF wSndQueue        EQU $DF81 ;   4 bytes: queued ids; the last one is started first
DEF wSndUnused85     EQU $DF85 ;   6 bytes: not used by the driver
DEF wCurTrack        EQU $DF8B ;   1 bytes: track being processed
DEF wSweepSave       EQU $DF8C ;   1 bytes: NR10 of music track 0 (restored after a CH1 SFX)
DEF wWavePtr         EQU $DF8D ;   2 bytes: wave of music track 2 (restored after a CH3 SFX)
DEF wSndUnused8F     EQU $DF8F ;   1 bytes: not used by the driver
DEF wTrackPan        EQU $DF90 ;   8 bytes: NR51 bits of each track
DEF wTrackVol        EQU $DF98 ;   8 bytes: current NRx2 value of each track
DEF wCallStack       EQU $DFA0 ;  16 bytes: return pointer of each track (2 bytes)
DEF wLoopStack       EQU $DFB0 ;  24 bytes: loop count + pointer of each track (3 bytes)

; Epoch sound driver type 2, version A: music driver (one copy in every music bank)
; Generated by tools/e2_gen.py from Ohasuta Yamachan & Raymond (J).
;
; Comments give the offset from the first instruction. The bank file that
; INCLUDEs this defines SOUND_RAM and the table labels used below.

; Mus_Init: start song [wMusicId]
Mus_Init:
    ld a,$00                          ; +$000
    ldh [rNR52],a                     ; +$002  NR52 off/on clears every sound register
    ld a,$80                          ; +$004
    ldh [rNR52],a                     ; +$006
    ld a,$77                          ; +$008
    ldh [rNR50],a                     ; +$00A
    ld a,$FF                          ; +$00C
    ldh [rNR51],a                     ; +$00E
    ld hl,SongTable                   ; +$010  header pointer = SongTable[wMusicId]
    ld a,[wMusicId]                   ; +$013
    ld b,a                            ; +$016
    inc b                             ; +$017
.findSong:
    ld a,[hli]                        ; +$018
    ld [wMusHdrLo],a                  ; +$019
    ld a,[hli]                        ; +$01C
    ld [wMusHdrHi],a                  ; +$01D
    dec b                             ; +$020
    jr nz,.findSong                   ; +$021
    ld a,[wMusHdrLo]                  ; +$023
    ld l,a                            ; +$026
    ld e,a                            ; +$027
    ld a,[wMusHdrHi]                  ; +$028
    ld h,a                            ; +$02B
    ld d,a                            ; +$02C
    ld a,[hli]                        ; +$02D  5 header words (offsets from the header)
    ld [wMusCh1PtrLo],a               ; +$02E
    ld a,[hli]                        ; +$031
    ld [wMusCh1PtrHi],a               ; +$032
    ld a,[hli]                        ; +$035
    ld [wMusCh2PtrLo],a               ; +$036
    ld a,[hli]                        ; +$039
    ld [wMusCh2PtrHi],a               ; +$03A
    ld a,[hli]                        ; +$03D
    ld [wMusCh3PtrLo],a               ; +$03E
    ld a,[hli]                        ; +$041
    ld [wMusCh3PtrHi],a               ; +$042
    ld a,[hli]                        ; +$045
    ld [wMusCh4PtrLo],a               ; +$046
    ld a,[hli]                        ; +$049
    ld [wMusCh4PtrHi],a               ; +$04A
    ld a,[hli]                        ; +$04D  word 5 is stored lo/hi but read back hi/lo: never used
    ld [wMusEndPtrA],a                ; +$04E
    ld a,[hli]                        ; +$051
    ld [wMusEndPtrB],a                ; +$052
    ld a,[wMusCh1PtrHi]               ; +$055  track pointers += header address
    ld h,a                            ; +$058
    ld a,[wMusCh1PtrLo]               ; +$059
    ld l,a                            ; +$05C
    add hl,de                         ; +$05D
    ld a,h                            ; +$05E
    ld [wMusCh1PtrHi],a               ; +$05F
    ld a,l                            ; +$062
    ld [wMusCh1PtrLo],a               ; +$063
    ld a,[wMusCh2PtrHi]               ; +$066
    ld h,a                            ; +$069
    ld a,[wMusCh2PtrLo]               ; +$06A
    ld l,a                            ; +$06D
    add hl,de                         ; +$06E
    ld a,h                            ; +$06F
    ld [wMusCh2PtrHi],a               ; +$070
    ld a,l                            ; +$073
    ld [wMusCh2PtrLo],a               ; +$074
    ld a,[wMusCh3PtrHi]               ; +$077
    ld h,a                            ; +$07A
    ld a,[wMusCh3PtrLo]               ; +$07B
    ld l,a                            ; +$07E
    add hl,de                         ; +$07F
    ld a,h                            ; +$080
    ld [wMusCh3PtrHi],a               ; +$081
    ld a,l                            ; +$084
    ld [wMusCh3PtrLo],a               ; +$085
    ld a,[wMusCh4PtrHi]               ; +$088
    ld h,a                            ; +$08B
    ld a,[wMusCh4PtrLo]               ; +$08C
    ld l,a                            ; +$08F
    add hl,de                         ; +$090
    ld a,h                            ; +$091
    ld [wMusCh4PtrHi],a               ; +$092
    ld a,l                            ; +$095
    ld [wMusCh4PtrLo],a               ; +$096
    ld a,[wMusEndPtrA]                ; +$099
    ld h,a                            ; +$09C
    ld a,[wMusEndPtrB]                ; +$09D
    ld l,a                            ; +$0A0
    add hl,de                         ; +$0A1
    ld a,h                            ; +$0A2
    ld [wMusEndPtrA],a                ; +$0A3
    ld a,l                            ; +$0A6
    ld [wMusEndPtrB],a                ; +$0A7
    xor a                             ; +$0AA  clear counters, end flags, modulation modes, locks, pans
    ld [wMusCh1Count],a               ; +$0AB
    ld [wMusCh2Count],a               ; +$0AE
    ld [wMusCh3Count],a               ; +$0B1
    ld [wMusCh4Count],a               ; +$0B4
    ld [wMusCh1End],a                 ; +$0B7
    ld [wMusCh2End],a                 ; +$0BA
    ld [wMusCh3End],a                 ; +$0BD
    ld [wMusCh4End],a                 ; +$0C0
    ld [wMusCh1ModMode],a             ; +$0C3
    ld [wMusCh2ModMode],a             ; +$0C6
    ld [wMusCh3ModMode],a             ; +$0C9
    ld [wCh1Lock],a                   ; +$0CC
    ld [wCh2Lock],a                   ; +$0CF
    ld [wCh3Lock],a                   ; +$0D2
    ld [wCh4Lock],a                   ; +$0D5
    ld [wMusCh1Pan],a                 ; +$0D8
    ld [wMusCh2Pan],a                 ; +$0DB
    ld [wMusCh3Pan],a                 ; +$0DE
    ld [wMusCh4Pan],a                 ; +$0E1
    ret                               ; +$0E4

; Mus_Update: once per frame
Mus_Update:
    push af                           ; +$0E5
    push bc                           ; +$0E6
    push de                           ; +$0E7
    push hl                           ; +$0E8
    ld a,[wMusicId]                   ; +$0E9
    cp $FF                            ; +$0EC
    jr z,.done                        ; +$0EE
    call Mus_Ch1                      ; +$0F0
    call Mus_Ch2                      ; +$0F3
    call Mus_Ch3                      ; +$0F6
    call Mus_Ch4                      ; +$0F9
    xor b                             ; +$0FC  stray instruction, b is overwritten next
    ld a,[wMusCh1End]                 ; +$0FD
    ld b,a                            ; +$100
    ld a,[wMusCh2End]                 ; +$101
    or b                              ; +$104
    ld b,a                            ; +$105
    ld a,[wMusCh3End]                 ; +$106
    or b                              ; +$109
    ld b,a                            ; +$10A
    ld a,[wMusCh4End]                 ; +$10B
    or b                              ; +$10E
    cp $FF                            ; +$10F  all four end flags set: $03|$0C|$30|$C0 = $FF
    jr nz,.done                       ; +$111
    ld [wMusicId],a                   ; +$113
.done:
    pop af                            ; +$116  pops in push order: af/bc/de/hl come back swapped
    pop bc                            ; +$117
    pop de                            ; +$118
    pop hl                            ; +$119
    ret                               ; +$11A

; channel 1
Mus_Ch1:
    ld a,[wMusCh1End]                 ; +$11B
    cp $00                            ; +$11E
    jp nz,Mus_Ch1Ret                  ; +$120
    ld a,[wMusCh1Count]               ; +$123
    cp $00                            ; +$126
    jp nz,Mus_Ch1Wait                 ; +$128
    ld a,[wMusCh1PtrHi]               ; +$12B
    ld b,a                            ; +$12E
    ld a,[wMusCh1PtrLo]               ; +$12F
    ld c,a                            ; +$132
    ld a,[bc]                         ; +$133  row byte
    cp $FF                            ; +$134
    jp z,Mus_Ch1CmdFF                 ; +$136
    cp $E0                            ; +$139
    jp z,Mus_Ch1Rest                  ; +$13B
    cp $F1                            ; +$13E
    jp z,Mus_Ch1CmdF1                 ; +$140
    cp $F2                            ; +$143
    jp z,Mus_Ch1CmdF2                 ; +$145
    cp $F0                            ; +$148
    jp z,Mus_Ch1CmdF0                 ; +$14A
    inc a                             ; +$14D  note: freq = FreqTable[note] (inc a + base FreqTable-2)
    ld hl,FreqTable - 2               ; +$14E
    ld e,a                            ; +$151
    ld d,$00                          ; +$152
    add hl,de                         ; +$154
    add hl,de                         ; +$155
    ld a,[hl]                         ; +$156
    ld [wMusCh1FreqLo],a              ; +$157
    inc hl                            ; +$15A
    ld a,[hl]                         ; +$15B
    ld [wMusCh1FreqHi],a              ; +$15C
    inc bc                            ; +$15F
    ld a,[wCh1Lock]                   ; +$160  lock 1: SFX owns the channel, write nothing
    cp $01                            ; +$163
    jr z,Mus_Ch1Length                ; +$165
    cp $02                            ; +$167
    call z,Mus_Ch1Restore             ; +$169  lock 2: restore the music instrument first
    ld a,[bc]                         ; +$16C  volume nibble -> NR12 bits 4-7
    swap a                            ; +$16D
    and $F0                           ; +$16F
    ld d,a                            ; +$171
    ldh a,[rNR12]                     ; +$172
    and $0F                           ; +$174
    or d                              ; +$176
    ldh [rNR12],a                     ; +$177
    ld a,[wMusCh1FreqLo]              ; +$179
    ldh [rNR13],a                     ; +$17C
    ld a,[wMusCh1FreqHi]              ; +$17E
    or $80                            ; +$181
    ldh [rNR14],a                     ; +$183

; row length byte; also restarts the pitch modulation
Mus_Ch1Length:
    inc bc                            ; +$185  length byte: row lasts that many frames
    ld a,[bc]                         ; +$186
    dec a                             ; +$187
    ld [wMusCh1Count],a               ; +$188
    inc bc                            ; +$18B
    ld a,b                            ; +$18C
    ld [wMusCh1PtrHi],a               ; +$18D
    ld a,c                            ; +$190
    ld [wMusCh1PtrLo],a               ; +$191
    ld hl,wMusCh1ModBuf               ; +$194  restart the modulation list
    ld a,h                            ; +$197
    ld [wMusCh1ModPtrHi],a            ; +$198
    ld a,l                            ; +$19B
    ld [wMusCh1ModPtrLo],a            ; +$19C
    ld a,[wMusCh1ModDelayInit]        ; +$19F
    ld [wMusCh1ModDelay],a            ; +$1A2
    ld a,[wMusCh1ModCountInit]        ; +$1A5
    ld [wMusCh1ModCount],a            ; +$1A8

Mus_Ch1Ret:
    ret                               ; +$1AB

; channel 2
Mus_Ch2:
    ld a,[wMusCh2End]                 ; +$1AC
    cp $00                            ; +$1AF
    jp nz,Mus_Ch2Ret                  ; +$1B1
    ld a,[wMusCh2Count]               ; +$1B4
    cp $00                            ; +$1B7
    jp nz,Mus_Ch2Wait                 ; +$1B9
    ld a,[wMusCh2PtrHi]               ; +$1BC
    ld b,a                            ; +$1BF
    ld a,[wMusCh2PtrLo]               ; +$1C0
    ld c,a                            ; +$1C3
    ld a,[bc]                         ; +$1C4
    cp $FF                            ; +$1C5
    jp z,Mus_Ch2CmdFF                 ; +$1C7
    cp $E0                            ; +$1CA
    jp z,Mus_Ch2Rest                  ; +$1CC
    cp $F1                            ; +$1CF
    jp z,Mus_Ch2CmdF1                 ; +$1D1
    cp $F2                            ; +$1D4
    jp z,Mus_Ch2CmdF2                 ; +$1D6
    cp $F0                            ; +$1D9
    jp z,Mus_Ch2CmdF0                 ; +$1DB
    inc a                             ; +$1DE
    ld hl,FreqTable - 2               ; +$1DF
    ld e,a                            ; +$1E2
    ld d,$00                          ; +$1E3
    add hl,de                         ; +$1E5
    add hl,de                         ; +$1E6
    ld a,[hl]                         ; +$1E7
    ld [wMusCh2FreqLo],a              ; +$1E8
    inc hl                            ; +$1EB
    ld a,[hl]                         ; +$1EC
    ld [wMusCh2FreqHi],a              ; +$1ED
    inc bc                            ; +$1F0
    ld a,[wCh2Lock]                   ; +$1F1
    cp $01                            ; +$1F4
    jr z,Mus_Ch2Length                ; +$1F6
    cp $02                            ; +$1F8
    call z,Mus_Ch2Restore             ; +$1FA
    ld a,[bc]                         ; +$1FD
    swap a                            ; +$1FE
    and $F0                           ; +$200
    ld d,a                            ; +$202
    ldh a,[rNR22]                     ; +$203
    and $0F                           ; +$205
    or d                              ; +$207
    ldh [rNR22],a                     ; +$208
    ld a,[wMusCh2FreqLo]              ; +$20A
    ldh [rNR23],a                     ; +$20D
    ld a,[wMusCh2FreqHi]              ; +$20F
    or $80                            ; +$212
    ldh [rNR24],a                     ; +$214

Mus_Ch2Length:
    inc bc                            ; +$216
    ld a,[bc]                         ; +$217
    dec a                             ; +$218
    ld [wMusCh2Count],a               ; +$219
    inc bc                            ; +$21C
    ld a,b                            ; +$21D
    ld [wMusCh2PtrHi],a               ; +$21E
    ld a,c                            ; +$221
    ld [wMusCh2PtrLo],a               ; +$222
    ld hl,wMusCh2ModBuf               ; +$225
    ld a,h                            ; +$228
    ld [wMusCh2ModPtrHi],a            ; +$229
    ld a,l                            ; +$22C
    ld [wMusCh2ModPtrLo],a            ; +$22D
    ld a,[wMusCh2ModDelayInit]        ; +$230
    ld [wMusCh2ModDelay],a            ; +$233
    ld a,[wMusCh2ModCountInit]        ; +$236
    ld [wMusCh2ModCount],a            ; +$239

Mus_Ch2Ret:
    ret                               ; +$23C

; channel 3
Mus_Ch3:
    ld a,[wMusCh3End]                 ; +$23D
    cp $00                            ; +$240
    jp nz,Mus_Ch3Ret                  ; +$242
    ld a,[wMusCh3Count]               ; +$245
    cp $00                            ; +$248
    jp nz,Mus_Ch3Wait                 ; +$24A
    ld a,[wMusCh3PtrHi]               ; +$24D
    ld b,a                            ; +$250
    ld a,[wMusCh3PtrLo]               ; +$251
    ld c,a                            ; +$254
    ld a,[bc]                         ; +$255
    cp $FF                            ; +$256
    jp z,Mus_Ch3CmdFF                 ; +$258
    cp $E0                            ; +$25B
    jp z,Mus_Ch3Rest                  ; +$25D
    cp $F1                            ; +$260
    jp z,Mus_Ch3CmdF1                 ; +$262
    cp $F2                            ; +$265
    jp z,Mus_Ch3CmdF2                 ; +$267
    cp $F0                            ; +$26A
    jp z,Mus_Ch3CmdF0                 ; +$26C
    inc a                             ; +$26F
    ld hl,FreqTable - 2               ; +$270
    ld e,a                            ; +$273
    ld d,$00                          ; +$274
    add hl,de                         ; +$276
    add hl,de                         ; +$277
    ld a,[hl]                         ; +$278
    ld [wMusCh3FreqLo],a              ; +$279
    inc hl                            ; +$27C
    ld a,[hl]                         ; +$27D
    ld [wMusCh3FreqHi],a              ; +$27E
    xor a                             ; +$281  NR30/NR31 cleared even when SFX owns ch3
    ldh [rNR30],a                     ; +$282
    ldh [rNR31],a                     ; +$284
    inc bc                            ; +$286  volume byte is skipped on ch3
    ld a,[wCh3Lock]                   ; +$287
    cp $01                            ; +$28A
    jr z,Mus_Ch3Length                ; +$28C
    cp $02                            ; +$28E
    call z,Mus_Ch3Restore             ; +$290
    ld a,[wMusCh3Level]               ; +$293
    ldh [rNR32],a                     ; +$296
    ld a,[wMusCh3FreqLo]              ; +$298
    ldh [rNR33],a                     ; +$29B
    ld a,$80                          ; +$29D
    ldh [rNR30],a                     ; +$29F
    ld a,[wMusCh3FreqHi]              ; +$2A1
    or $80                            ; +$2A4
    ldh [rNR34],a                     ; +$2A6

Mus_Ch3Length:
    inc bc                            ; +$2A8
    ld a,[bc]                         ; +$2A9
    dec a                             ; +$2AA
    ld [wMusCh3Count],a               ; +$2AB
    inc bc                            ; +$2AE
    ld a,b                            ; +$2AF
    ld [wMusCh3PtrHi],a               ; +$2B0
    ld a,c                            ; +$2B3
    ld [wMusCh3PtrLo],a               ; +$2B4
    ld hl,wMusCh3ModBuf               ; +$2B7
    ld a,h                            ; +$2BA
    ld [wMusCh3ModPtrHi],a            ; +$2BB
    ld a,l                            ; +$2BE
    ld [wMusCh3ModPtrLo],a            ; +$2BF
    ld a,[wMusCh3ModDelayInit]        ; +$2C2
    ld [wMusCh3ModDelay],a            ; +$2C5
    ld a,[wMusCh3ModCountInit]        ; +$2C8
    ld [wMusCh3ModCount],a            ; +$2CB

Mus_Ch3Ret:
    ret                               ; +$2CE

; channel 4
Mus_Ch4:
    ld a,[wMusCh4End]                 ; +$2CF
    cp $00                            ; +$2D2
    jp nz,Mus_Ch4Ret                  ; +$2D4
    ld a,[wMusCh4Count]               ; +$2D7
    cp $00                            ; +$2DA
    jp nz,Mus_Ch4Wait                 ; +$2DC
    ld a,[wMusCh4PtrHi]               ; +$2DF
    ld b,a                            ; +$2E2
    ld a,[wMusCh4PtrLo]               ; +$2E3
    ld c,a                            ; +$2E6
    ld a,[bc]                         ; +$2E7
    cp $FF                            ; +$2E8
    jp z,Mus_Ch4CmdFF                 ; +$2EA
    cp $E0                            ; +$2ED
    jp z,Mus_Ch4Rest                  ; +$2EF
    cp $F1                            ; +$2F2
    jp z,Mus_Ch4CmdF1                 ; +$2F4
    cp $F0                            ; +$2F7
    jp nz,Mus_Ch4Note                 ; +$2F9
    inc bc                            ; +$2FC  $F0 on ch4: pointer is not stored, so this hangs
    inc bc                            ; +$2FD
    jp Mus_Ch4                        ; +$2FE

Mus_Ch4Note:
    call Mus_Ch4LoadDrum              ; +$301
    ld hl,FreqTable - 2               ; +$304  leftover: hl is not used
    inc bc                            ; +$307
    ld a,[wCh4Lock]                   ; +$308
    cp $01                            ; +$30B
    jr z,Mus_Ch4Length                ; +$30D
    cp $02                            ; +$30F
    call z,Mus_Ch4Restore             ; +$311
    ld a,[bc]                         ; +$314
    swap a                            ; +$315
    and $F0                           ; +$317
    ld d,a                            ; +$319
    ldh a,[rNR42]                     ; +$31A
    and $0F                           ; +$31C
    or d                              ; +$31E
    ldh [rNR42],a                     ; +$31F
    ld a,[wMusCh4NR44]                ; +$321
    or $80                            ; +$324
    ldh [rNR44],a                     ; +$326

Mus_Ch4Length:
    inc bc                            ; +$328
    ld a,[bc]                         ; +$329
    dec a                             ; +$32A
    ld [wMusCh4Count],a               ; +$32B
    inc bc                            ; +$32E
    ld a,b                            ; +$32F
    ld [wMusCh4PtrHi],a               ; +$330
    ld a,c                            ; +$333
    ld [wMusCh4PtrLo],a               ; +$334

Mus_Ch4Ret:
    ret                               ; +$337

; $E0: rest
Mus_Ch1Rest:
    ld a,[wMusCh1RestNR14]            ; +$338
    cp $00                            ; +$33B  rest byte 0: nothing to do, the note keeps sounding
    jp z,Mus_Ch1Length                ; +$33D
    ld a,[wCh1Lock]                   ; +$340
    cp $01                            ; +$343
    jp z,Mus_Ch1Length                ; +$345
    xor a                             ; +$348  NR12 = 0 turns the DAC off; the rewrite does not retrigger unless bit 7 is set
    ldh [rNR12],a                     ; +$349
    ld a,[wMusCh1Env]                 ; +$34B
    ldh [rNR12],a                     ; +$34E
    ld a,[wMusCh1RestNR14]            ; +$350
    ldh [rNR14],a                     ; +$353
    jp Mus_Ch1Length                  ; +$355

; $E0: rest
Mus_Ch2Rest:
    ld a,[wMusCh2RestNR24]            ; +$358
    cp $00                            ; +$35B
    jp z,Mus_Ch2Length                ; +$35D
    ld a,[wCh2Lock]                   ; +$360
    cp $01                            ; +$363
    jp z,Mus_Ch2Length                ; +$365
    xor a                             ; +$368
    ldh [rNR22],a                     ; +$369
    ld a,[wMusCh2Env]                 ; +$36B
    ldh [rNR22],a                     ; +$36E
    ld a,[wMusCh2RestNR24]            ; +$370
    ldh [rNR24],a                     ; +$373
    jp Mus_Ch2Length                  ; +$375

; $E0: rest
Mus_Ch3Rest:
    ld a,[wMusCh3RestFlag]            ; +$378
    cp $00                            ; +$37B
    jp z,Mus_Ch3Length                ; +$37D
    ld a,[wCh3Lock]                   ; +$380
    cp $01                            ; +$383
    jp z,Mus_Ch3Length                ; +$385
    xor a                             ; +$388
    ldh [rNR30],a                     ; +$389
    jp Mus_Ch3Length                  ; +$38B

; $E0: rest
Mus_Ch4Rest:
    ld a,[wMusCh4NR44]                ; +$38E
    cp $00                            ; +$391
    jp z,Mus_Ch4Length                ; +$393
    ld a,[wCh4Lock]                   ; +$396
    cp $01                            ; +$399
    jp z,Mus_Ch4Length                ; +$39B
    xor a                             ; +$39E
    ldh [rNR42],a                     ; +$39F
    ldh [rNR43],a                     ; +$3A1
    ld a,[wMusCh4NR42]                ; +$3A3
    ldh [rNR42],a                     ; +$3A6
    ld a,[wMusCh4NR43]                ; +$3A8
    ldh [rNR43],a                     ; +$3AB
    ld a,[wMusCh4NR44]                ; +$3AD
    ldh [rNR44],a                     ; +$3B0
    jp Mus_Ch4Length                  ; +$3B2

; row still running: count down, then modulation
Mus_Ch1Wait:
    dec a                             ; +$3B5
    ld [wMusCh1Count],a               ; +$3B6
    ld a,[wCh1Lock]                   ; +$3B9
    cp $00                            ; +$3BC
    jr nz,Mus_Ch1WaitDone             ; +$3BE
    ld a,[wMusCh1ModMode]             ; +$3C0
    cp $00                            ; +$3C3
    jr z,Mus_Ch1WaitDone              ; +$3C5
    ld a,[wMusCh1ModDelay]            ; +$3C7
    cp $00                            ; +$3CA
    jp z,Mus_Ch1Mod                   ; +$3CC
    dec a                             ; +$3CF
    ld [wMusCh1ModDelay],a            ; +$3D0

Mus_Ch1WaitDone:
    jp Mus_Ch1Ret                     ; +$3D3

Mus_Ch2Wait:
    dec a                             ; +$3D6
    ld [wMusCh2Count],a               ; +$3D7
    ld a,[wCh2Lock]                   ; +$3DA
    cp $00                            ; +$3DD
    jr nz,Mus_Ch2WaitDone             ; +$3DF
    ld a,[wMusCh2ModMode]             ; +$3E1
    cp $00                            ; +$3E4
    jr z,Mus_Ch2WaitDone              ; +$3E6
    ld a,[wMusCh2ModDelay]            ; +$3E8
    cp $00                            ; +$3EB
    jp z,Mus_Ch2Mod                   ; +$3ED
    dec a                             ; +$3F0
    ld [wMusCh2ModDelay],a            ; +$3F1

Mus_Ch2WaitDone:
    jp Mus_Ch2Ret                     ; +$3F4

Mus_Ch3Wait:

; Epoch sound driver type 2, version B: music driver (one copy in every music bank)
; Generated by tools/e2_gen.py from Doraemon - Aruke Aruke Labyrinth (J).
;
; Comments give the offset from the first instruction. The bank file that
; INCLUDEs this defines SOUND_RAM and the table labels used below.

; Mus_Init: start song [wMusicId]
Mus_Init:
    ld a,$00                          ; +$000
    ldh [rNR52],a                     ; +$002  NR52 off/on clears every sound register
    xor a                             ; +$004  dead instruction
    ld a,$80                          ; +$005
    ldh [rNR52],a                     ; +$007
    ld a,$77                          ; +$009
    ldh [rNR50],a                     ; +$00B
    ld a,$FF                          ; +$00D
    ldh [rNR51],a                     ; +$00F
    ld hl,SongTable                   ; +$011  header pointer = SongTable[wMusicId]
    ld a,[wMusicId]                   ; +$014
    ld b,a                            ; +$017
    inc b                             ; +$018
.findSong:
    ld a,[hli]                        ; +$019
    ld [wMusHdrLo],a                  ; +$01A
    ld a,[hli]                        ; +$01D
    ld [wMusHdrHi],a                  ; +$01E
    dec b                             ; +$021
    jr nz,.findSong                   ; +$022
    ld a,[wMusHdrLo]                  ; +$024
    ld l,a                            ; +$027
    ld e,a                            ; +$028
    ld a,[wMusHdrHi]                  ; +$029
    ld h,a                            ; +$02C
    ld d,a                            ; +$02D
    ld a,[hli]                        ; +$02E  5 header words (offsets from the header)
    ld [wMusCh1PtrLo],a               ; +$02F
    ld a,[hli]                        ; +$032
    ld [wMusCh1PtrHi],a               ; +$033
    ld a,[hli]                        ; +$036
    ld [wMusCh2PtrLo],a               ; +$037
    ld a,[hli]                        ; +$03A
    ld [wMusCh2PtrHi],a               ; +$03B
    ld a,[hli]                        ; +$03E
    ld [wMusCh3PtrLo],a               ; +$03F
    ld a,[hli]                        ; +$042
    ld [wMusCh3PtrHi],a               ; +$043
    ld a,[hli]                        ; +$046
    ld [wMusCh4PtrLo],a               ; +$047
    ld a,[hli]                        ; +$04A
    ld [wMusCh4PtrHi],a               ; +$04B
    ld a,[hli]                        ; +$04E  word 5 is stored lo/hi but read back hi/lo: never used
    ld [wMusEndPtrA],a                ; +$04F
    ld a,[hli]                        ; +$052
    ld [wMusEndPtrB],a                ; +$053
    ld a,[wMusCh1PtrHi]               ; +$056  track pointers += header address
    ld h,a                            ; +$059
    ld a,[wMusCh1PtrLo]               ; +$05A
    ld l,a                            ; +$05D
    add hl,de                         ; +$05E
    ld a,h                            ; +$05F
    ld [wMusCh1PtrHi],a               ; +$060
    ld a,l                            ; +$063
    ld [wMusCh1PtrLo],a               ; +$064
    ld a,[wMusCh2PtrHi]               ; +$067
    ld h,a                            ; +$06A
    ld a,[wMusCh2PtrLo]               ; +$06B
    ld l,a                            ; +$06E
    add hl,de                         ; +$06F
    ld a,h                            ; +$070
    ld [wMusCh2PtrHi],a               ; +$071
    ld a,l                            ; +$074
    ld [wMusCh2PtrLo],a               ; +$075
    ld a,[wMusCh3PtrHi]               ; +$078
    ld h,a                            ; +$07B
    ld a,[wMusCh3PtrLo]               ; +$07C
    ld l,a                            ; +$07F
    add hl,de                         ; +$080
    ld a,h                            ; +$081
    ld [wMusCh3PtrHi],a               ; +$082
    ld a,l                            ; +$085
    ld [wMusCh3PtrLo],a               ; +$086
    ld a,[wMusCh4PtrHi]               ; +$089
    ld h,a                            ; +$08C
    ld a,[wMusCh4PtrLo]               ; +$08D
    ld l,a                            ; +$090
    add hl,de                         ; +$091
    ld a,h                            ; +$092
    ld [wMusCh4PtrHi],a               ; +$093
    ld a,l                            ; +$096
    ld [wMusCh4PtrLo],a               ; +$097
    ld a,[wMusEndPtrA]                ; +$09A
    ld h,a                            ; +$09D
    ld a,[wMusEndPtrB]                ; +$09E
    ld l,a                            ; +$0A1
    add hl,de                         ; +$0A2
    ld a,h                            ; +$0A3
    ld [wMusEndPtrA],a                ; +$0A4
    ld a,l                            ; +$0A7
    ld [wMusEndPtrB],a                ; +$0A8
    xor a                             ; +$0AB  clear counters, end flags, modulation modes, locks, pans
    ld [wMusCh1Count],a               ; +$0AC
    ld [wMusCh2Count],a               ; +$0AF
    ld [wMusCh3Count],a               ; +$0B2
    ld [wMusCh4Count],a               ; +$0B5
    ld [wMusCh1End],a                 ; +$0B8
    ld [wMusCh2End],a                 ; +$0BB
    ld [wMusCh3End],a                 ; +$0BE
    ld [wMusCh4End],a                 ; +$0C1
    ld [wMusCh1ModMode],a             ; +$0C4
    ld [wMusCh2ModMode],a             ; +$0C7
    ld [wMusCh3ModMode],a             ; +$0CA
    ld [wCh1Lock],a                   ; +$0CD
    ld [wCh2Lock],a                   ; +$0D0
    ld [wCh3Lock],a                   ; +$0D3
    ld [wCh4Lock],a                   ; +$0D6
    ld [wMusCh1Pan],a                 ; +$0D9
    ld [wMusCh2Pan],a                 ; +$0DC
    ld [wMusCh3Pan],a                 ; +$0DF
    ld [wMusCh4Pan],a                 ; +$0E2
    ret                               ; +$0E5

; Mus_Update: once per frame
Mus_Update:
    push af                           ; +$0E6
    push bc                           ; +$0E7
    push de                           ; +$0E8
    push hl                           ; +$0E9
    ld a,[wMusicId]                   ; +$0EA
    cp $FF                            ; +$0ED
    jr z,.done                        ; +$0EF
    call Mus_Ch1                      ; +$0F1
    call Mus_Ch2                      ; +$0F4
    call Mus_Ch3                      ; +$0F7
    call Mus_Ch4                      ; +$0FA
    xor b                             ; +$0FD  stray instruction, b is overwritten next
    ld a,[wMusCh1End]                 ; +$0FE
    ld b,a                            ; +$101
    ld a,[wMusCh2End]                 ; +$102
    or b                              ; +$105
    ld b,a                            ; +$106
    ld a,[wMusCh3End]                 ; +$107
    or b                              ; +$10A
    ld b,a                            ; +$10B
    ld a,[wMusCh4End]                 ; +$10C
    or b                              ; +$10F
    cp $FF                            ; +$110  all four end flags set: $03|$0C|$30|$C0 = $FF
    jr nz,.done                       ; +$112
    ld [wMusicId],a                   ; +$114
.done:
    pop af                            ; +$117  pops in push order: af/bc/de/hl come back swapped
    pop bc                            ; +$118
    pop de                            ; +$119
    pop hl                            ; +$11A
    ret                               ; +$11B

; channel 1
Mus_Ch1:
    ld a,[wMusCh1End]                 ; +$11C
    cp $00                            ; +$11F
    jp nz,Mus_Ch1Ret                  ; +$121
    ld a,[wMusCh1Count]               ; +$124
    cp $00                            ; +$127
    jp nz,Mus_Ch1Wait                 ; +$129
    ld a,[wMusCh1PtrHi]               ; +$12C
    ld b,a                            ; +$12F
    ld a,[wMusCh1PtrLo]               ; +$130
    ld c,a                            ; +$133
    ld a,[bc]                         ; +$134  row byte
    cp $FF                            ; +$135
    jp z,Mus_Ch1CmdFF                 ; +$137
    cp $E0                            ; +$13A
    jp z,Mus_Ch1Rest                  ; +$13C
    cp $F1                            ; +$13F
    jp z,Mus_Ch1CmdF1                 ; +$141
    cp $F2                            ; +$144
    jp z,Mus_Ch1CmdF2                 ; +$146
    cp $F0                            ; +$149
    jp z,Mus_Ch1CmdF0                 ; +$14B
    inc a                             ; +$14E  note: freq = FreqTable[note] (inc a + base FreqTable-2)
    ld hl,FreqTable - 2               ; +$14F
    ld e,a                            ; +$152
    ld d,$00                          ; +$153
    add hl,de                         ; +$155
    add hl,de                         ; +$156
    ld a,[hl]                         ; +$157
    ld [wMusCh1FreqLo],a              ; +$158
    inc hl                            ; +$15B
    ld a,[hl]                         ; +$15C
    ld [wMusCh1FreqHi],a              ; +$15D
    inc bc                            ; +$160
    ld a,[wCh1Lock]                   ; +$161  lock 1: SFX owns the channel, write nothing
    cp $01                            ; +$164
    jr z,Mus_Ch1Length                ; +$166
    cp $02                            ; +$168
    call z,Mus_Ch1Restore             ; +$16A  lock 2: restore the music instrument first
    ld a,[bc]                         ; +$16D  volume nibble -> NR12 bits 4-7
    swap a                            ; +$16E
    and $F0                           ; +$170
    ld d,a                            ; +$172
    ldh a,[rNR12]                     ; +$173
    and $0F                           ; +$175
    or d                              ; +$177
    ldh [rNR12],a                     ; +$178
    ld a,[wMusCh1FreqLo]              ; +$17A
    ldh [rNR13],a                     ; +$17D
    ld a,[wMusCh1FreqHi]              ; +$17F
    or $80                            ; +$182
    ldh [rNR14],a                     ; +$184

; row length byte; also restarts the pitch modulation
Mus_Ch1Length:
    inc bc                            ; +$186  length byte: row lasts that many frames
    ld a,[bc]                         ; +$187
    dec a                             ; +$188
    ld [wMusCh1Count],a               ; +$189
    inc bc                            ; +$18C
    ld a,b                            ; +$18D
    ld [wMusCh1PtrHi],a               ; +$18E
    ld a,c                            ; +$191
    ld [wMusCh1PtrLo],a               ; +$192
    ld hl,wMusCh1ModBuf               ; +$195  restart the modulation list
    ld a,h                            ; +$198
    ld [wMusCh1ModPtrHi],a            ; +$199
    ld a,l                            ; +$19C
    ld [wMusCh1ModPtrLo],a            ; +$19D
    ld a,[wMusCh1ModDelayInit]        ; +$1A0
    ld [wMusCh1ModDelay],a            ; +$1A3
    ld a,[wMusCh1ModCountInit]        ; +$1A6
    ld [wMusCh1ModCount],a            ; +$1A9

Mus_Ch1Ret:
    ret                               ; +$1AC

; channel 2
Mus_Ch2:
    ld a,[wMusCh2End]                 ; +$1AD
    cp $00                            ; +$1B0
    jp nz,Mus_Ch2Ret                  ; +$1B2
    ld a,[wMusCh2Count]               ; +$1B5
    cp $00                            ; +$1B8
    jp nz,Mus_Ch2Wait                 ; +$1BA
    ld a,[wMusCh2PtrHi]               ; +$1BD
    ld b,a                            ; +$1C0
    ld a,[wMusCh2PtrLo]               ; +$1C1
    ld c,a                            ; +$1C4
    ld a,[bc]                         ; +$1C5
    cp $FF                            ; +$1C6
    jp z,Mus_Ch2CmdFF                 ; +$1C8
    cp $E0                            ; +$1CB
    jp z,Mus_Ch2Rest                  ; +$1CD
    cp $F1                            ; +$1D0
    jp z,Mus_Ch2CmdF1                 ; +$1D2
    cp $F2                            ; +$1D5
    jp z,Mus_Ch2CmdF2                 ; +$1D7
    cp $F0                            ; +$1DA
    jp z,Mus_Ch2CmdF0                 ; +$1DC
    inc a                             ; +$1DF
    ld hl,FreqTable - 2               ; +$1E0
    ld e,a                            ; +$1E3
    ld d,$00                          ; +$1E4
    add hl,de                         ; +$1E6
    add hl,de                         ; +$1E7
    ld a,[hl]                         ; +$1E8
    ld [wMusCh2FreqLo],a              ; +$1E9
    inc hl                            ; +$1EC
    ld a,[hl]                         ; +$1ED
    ld [wMusCh2FreqHi],a              ; +$1EE
    inc bc                            ; +$1F1
    ld a,[wCh2Lock]                   ; +$1F2
    cp $01                            ; +$1F5
    jr z,Mus_Ch2Length                ; +$1F7
    cp $02                            ; +$1F9
    call z,Mus_Ch2Restore             ; +$1FB
    ld a,[bc]                         ; +$1FE
    swap a                            ; +$1FF
    and $F0                           ; +$201
    ld d,a                            ; +$203
    ldh a,[rNR22]                     ; +$204
    and $0F                           ; +$206
    or d                              ; +$208
    ldh [rNR22],a                     ; +$209
    ld a,[wMusCh2FreqLo]              ; +$20B
    ldh [rNR23],a                     ; +$20E
    ld a,[wMusCh2FreqHi]              ; +$210
    or $80                            ; +$213
    ldh [rNR24],a                     ; +$215

Mus_Ch2Length:
    inc bc                            ; +$217
    ld a,[bc]                         ; +$218
    dec a                             ; +$219
    ld [wMusCh2Count],a               ; +$21A
    inc bc                            ; +$21D
    ld a,b                            ; +$21E
    ld [wMusCh2PtrHi],a               ; +$21F
    ld a,c                            ; +$222
    ld [wMusCh2PtrLo],a               ; +$223
    ld hl,wMusCh2ModBuf               ; +$226
    ld a,h                            ; +$229
    ld [wMusCh2ModPtrHi],a            ; +$22A
    ld a,l                            ; +$22D
    ld [wMusCh2ModPtrLo],a            ; +$22E
    ld a,[wMusCh2ModDelayInit]        ; +$231
    ld [wMusCh2ModDelay],a            ; +$234
    ld a,[wMusCh2ModCountInit]        ; +$237
    ld [wMusCh2ModCount],a            ; +$23A

Mus_Ch2Ret:
    ret                               ; +$23D

; channel 3
Mus_Ch3:
    ld a,[wMusCh3End]                 ; +$23E
    cp $00                            ; +$241
    jp nz,Mus_Ch3Ret                  ; +$243
    ld a,[wMusCh3Count]               ; +$246
    cp $00                            ; +$249
    jp nz,Mus_Ch3Wait                 ; +$24B
    ld a,[wMusCh3PtrHi]               ; +$24E
    ld b,a                            ; +$251
    ld a,[wMusCh3PtrLo]               ; +$252
    ld c,a                            ; +$255
    ld a,[bc]                         ; +$256
    cp $FF                            ; +$257
    jp z,Mus_Ch3CmdFF                 ; +$259
    cp $E0                            ; +$25C
    jp z,Mus_Ch3Rest                  ; +$25E
    cp $F1                            ; +$261
    jp z,Mus_Ch3CmdF1                 ; +$263
    cp $F2                            ; +$266
    jp z,Mus_Ch3CmdF2                 ; +$268
    cp $F0                            ; +$26B
    jp z,Mus_Ch3CmdF0                 ; +$26D
    inc a                             ; +$270
    ld hl,FreqTable - 2               ; +$271
    ld e,a                            ; +$274
    ld d,$00                          ; +$275
    add hl,de                         ; +$277
    add hl,de                         ; +$278
    ld a,[hl]                         ; +$279
    ld [wMusCh3FreqLo],a              ; +$27A
    inc hl                            ; +$27D
    ld a,[hl]                         ; +$27E
    ld [wMusCh3FreqHi],a              ; +$27F
    xor a                             ; +$282  NR30/NR31 cleared even when SFX owns ch3
    ldh [rNR30],a                     ; +$283
    ldh [rNR31],a                     ; +$285
    inc bc                            ; +$287  volume byte is skipped on ch3
    ld a,[wCh3Lock]                   ; +$288
    cp $01                            ; +$28B
    jr z,Mus_Ch3Length                ; +$28D
    cp $02                            ; +$28F
    call z,Mus_Ch3Restore             ; +$291
    ld a,[wMusCh3Level]               ; +$294
    ldh [rNR32],a                     ; +$297
    ld a,[wMusCh3FreqLo]              ; +$299
    ldh [rNR33],a                     ; +$29C
    ld a,$80                          ; +$29E
    ldh [rNR30],a                     ; +$2A0
    ld a,[wMusCh3FreqHi]              ; +$2A2
    or $80                            ; +$2A5
    ldh [rNR34],a                     ; +$2A7

Mus_Ch3Length:
    inc bc                            ; +$2A9
    ld a,[bc]                         ; +$2AA
    dec a                             ; +$2AB
    ld [wMusCh3Count],a               ; +$2AC
    inc bc                            ; +$2AF
    ld a,b                            ; +$2B0
    ld [wMusCh3PtrHi],a               ; +$2B1
    ld a,c                            ; +$2B4
    ld [wMusCh3PtrLo],a               ; +$2B5
    ld hl,wMusCh3ModBuf               ; +$2B8
    ld a,h                            ; +$2BB
    ld [wMusCh3ModPtrHi],a            ; +$2BC
    ld a,l                            ; +$2BF
    ld [wMusCh3ModPtrLo],a            ; +$2C0
    ld a,[wMusCh3ModDelayInit]        ; +$2C3
    ld [wMusCh3ModDelay],a            ; +$2C6
    ld a,[wMusCh3ModCountInit]        ; +$2C9
    ld [wMusCh3ModCount],a            ; +$2CC

Mus_Ch3Ret:
    ret                               ; +$2CF

; channel 4
Mus_Ch4:
    ld a,[wMusCh4End]                 ; +$2D0
    cp $00                            ; +$2D3
    jp nz,Mus_Ch4Ret                  ; +$2D5
    ld a,[wMusCh4Count]               ; +$2D8
    cp $00                            ; +$2DB
    jp nz,Mus_Ch4Wait                 ; +$2DD
    ld a,[wMusCh4PtrHi]               ; +$2E0
    ld b,a                            ; +$2E3
    ld a,[wMusCh4PtrLo]               ; +$2E4
    ld c,a                            ; +$2E7
    ld a,[bc]                         ; +$2E8
    cp $FF                            ; +$2E9
    jp z,Mus_Ch4CmdFF                 ; +$2EB
    cp $E0                            ; +$2EE
    jp z,Mus_Ch4Rest                  ; +$2F0
    cp $F1                            ; +$2F3
    jp z,Mus_Ch4CmdF1                 ; +$2F5
    cp $F0                            ; +$2F8
    jp nz,Mus_Ch4Note                 ; +$2FA
    inc bc                            ; +$2FD  $F0 on ch4: pointer is not stored, so this hangs
    inc bc                            ; +$2FE
    jp Mus_Ch4                        ; +$2FF

Mus_Ch4Note:
    call Mus_Ch4LoadDrum              ; +$302
    ld hl,FreqTable - 2               ; +$305  leftover: hl is not used
    inc bc                            ; +$308
    ld a,[wCh4Lock]                   ; +$309
    cp $01                            ; +$30C
    jr z,Mus_Ch4Length                ; +$30E
    cp $02                            ; +$310
    call z,Mus_Ch4Restore             ; +$312
    ld a,[bc]                         ; +$315
    swap a                            ; +$316
    and $F0                           ; +$318
    ld d,a                            ; +$31A
    ldh a,[rNR42]                     ; +$31B
    and $0F                           ; +$31D
    or d                              ; +$31F
    ldh [rNR42],a                     ; +$320
    ld a,[wMusCh4NR44]                ; +$322
    or $80                            ; +$325
    ldh [rNR44],a                     ; +$327

Mus_Ch4Length:
    inc bc                            ; +$329
    ld a,[bc]                         ; +$32A
    dec a                             ; +$32B
    ld [wMusCh4Count],a               ; +$32C
    inc bc                            ; +$32F
    ld a,b                            ; +$330
    ld [wMusCh4PtrHi],a               ; +$331
    ld a,c                            ; +$334
    ld [wMusCh4PtrLo],a               ; +$335

Mus_Ch4Ret:
    ret                               ; +$338

; $E0: rest
Mus_Ch1Rest:
    ld a,[wMusCh1RestNR14]            ; +$339
    cp $00                            ; +$33C  rest byte 0: nothing to do, the note keeps sounding
    jp z,Mus_Ch1Length                ; +$33E
    ld a,[wCh1Lock]                   ; +$341
    cp $01                            ; +$344
    jp z,Mus_Ch1Length                ; +$346
    xor a                             ; +$349  NR12 = 0 turns the DAC off; the rewrite does not retrigger unless bit 7 is set
    ldh [rNR12],a                     ; +$34A
    ld a,[wMusCh1Env]                 ; +$34C
    ldh [rNR12],a                     ; +$34F
    ld a,[wMusCh1RestNR14]            ; +$351
    ldh [rNR14],a                     ; +$354
    jp Mus_Ch1Length                  ; +$356

; $E0: rest
Mus_Ch2Rest:
    ld a,[wMusCh2RestNR24]            ; +$359
    cp $00                            ; +$35C
    jp z,Mus_Ch2Length                ; +$35E
    ld a,[wCh2Lock]                   ; +$361
    cp $01                            ; +$364
    jp z,Mus_Ch2Length                ; +$366
    xor a                             ; +$369
    ldh [rNR22],a                     ; +$36A
    ld a,[wMusCh2Env]                 ; +$36C
    ldh [rNR22],a                     ; +$36F
    ld a,[wMusCh2RestNR24]            ; +$371
    ldh [rNR24],a                     ; +$374
    jp Mus_Ch2Length                  ; +$376

; $E0: rest
Mus_Ch3Rest:
    ld a,[wMusCh3RestFlag]            ; +$379
    cp $00                            ; +$37C
    jp z,Mus_Ch3Length                ; +$37E
    ld a,[wCh3Lock]                   ; +$381
    cp $01                            ; +$384
    jp z,Mus_Ch3Length                ; +$386
    xor a                             ; +$389
    ldh [rNR30],a                     ; +$38A
    jp Mus_Ch3Length                  ; +$38C

; $E0: rest
Mus_Ch4Rest:
    ld a,[wMusCh4NR44]                ; +$38F
    cp $00                            ; +$392
    jp z,Mus_Ch4Length                ; +$394
    ld a,[wCh4Lock]                   ; +$397
    cp $01                            ; +$39A
    jp z,Mus_Ch4Length                ; +$39C
    xor a                             ; +$39F
    ldh [rNR42],a                     ; +$3A0
    ldh [rNR43],a                     ; +$3A2
    ld a,[wMusCh4NR42]                ; +$3A4
    ldh [rNR42],a                     ; +$3A7
    ld a,[wMusCh4NR43]                ; +$3A9
    ldh [rNR43],a                     ; +$3AC
    ld a,[wMusCh4NR44]                ; +$3AE
    ldh [rNR44],a                     ; +$3B1
    jp Mus_Ch4Length                  ; +$3B3

; row still running: count down, then modulation
Mus_Ch1Wait:
    dec a                             ; +$3B6
    ld [wMusCh1Count],a               ; +$3B7
    ld a,[wCh1Lock]                   ; +$3BA
    cp $00                            ; +$3BD
    jr nz,Mus_Ch1WaitDone             ; +$3BF
    ld a,[wMusCh1ModMode]             ; +$3C1
    cp $00                            ; +$3C4
    jr z,Mus_Ch1WaitDone              ; +$3C6
    ld a,[wMusCh1ModDelay]            ; +$3C8
    cp $00                            ; +$3CB
    jp z,Mus_Ch1Mod                   ; +$3CD
    dec a                             ; +$3D0
    ld [wMusCh1ModDelay],a            ; +$3D1

Mus_Ch1WaitDone:
    jp Mus_Ch1Ret                     ; +$3D4

Mus_Ch2Wait:
    dec a                             ; +$3D7
    ld [wMusCh2Count],a               ; +$3D8
    ld a,[wCh2Lock]                   ; +$3DB
    cp $00                            ; +$3DE
    jr nz,Mus_Ch2WaitDone             ; +$3E0
    ld a,[wMusCh2ModMode]             ; +$3E2
    cp $00                            ; +$3E5
    jr z,Mus_Ch2WaitDone              ; +$3E7
    ld a,[wMusCh2ModDelay]            ; +$3E9
    cp $00                            ; +$3EC
    jp z,Mus_Ch2Mod                   ; +$3EE
    dec a                             ; +$3F1
    ld [wMusCh2ModDelay],a            ; +$3F2

Mus_Ch2WaitDone:

; Epoch sound driver type 2, version C: music driver (one copy in every music bank)
; Generated by tools/e2_gen.py from Sylvanian Families - Otogi no Kuni no Pendant (J).
;
; Comments give the offset from the first instruction. The bank file that
; INCLUDEs this defines SOUND_RAM and the table labels used below.

; Mus_Init: start song [wMusicId]
Mus_Init:
    ld a,$01                          ; +$000  C: busy flag, Mus_Update does nothing while it is set
    ld [wMusBusy],a                   ; +$002
    ld a,[wCh1Lock]                   ; +$005  C: silence only the channels the SFX does not hold (no NR52 reset)
    cp $01                            ; +$008
    jp z,.ch2                         ; +$00A
    xor a                             ; +$00D
    ldh [rNR12],a                     ; +$00E
.ch2:
    ld a,[wCh2Lock]                   ; +$010
    cp $01                            ; +$013
    jp z,.ch3                         ; +$015
    xor a                             ; +$018
    ldh [rNR22],a                     ; +$019
.ch3:
    ld a,[wCh3Lock]                   ; +$01B
    cp $01                            ; +$01E
    jp z,.ch4                         ; +$020
    xor a                             ; +$023
    ldh [rNR30],a                     ; +$024
.ch4:
    ld a,[wCh4Lock]                   ; +$026
    cp $01                            ; +$029
    jp z,.power                       ; +$02B
    xor a                             ; +$02E
    ldh [rNR42],a                     ; +$02F
    ldh [rNR43],a                     ; +$031
.power:
    xor a                             ; +$033  dead instruction
    ld a,$80                          ; +$034
    ldh [rNR52],a                     ; +$036
    ld a,$77                          ; +$038
    ldh [rNR50],a                     ; +$03A
    ld a,$FF                          ; +$03C
    ldh [rNR51],a                     ; +$03E
    ld hl,SongTable                   ; +$040  header pointer = SongTable[wMusicId]
    ld a,[wMusicId]                   ; +$043
    ld b,a                            ; +$046
    inc b                             ; +$047
.findSong:
    ld a,[hli]                        ; +$048
    ld [wMusHdrLo],a                  ; +$049
    ld a,[hli]                        ; +$04C
    ld [wMusHdrHi],a                  ; +$04D
    dec b                             ; +$050
    jr nz,.findSong                   ; +$051
    ld a,[wMusHdrLo]                  ; +$053
    ld l,a                            ; +$056
    ld e,a                            ; +$057
    ld a,[wMusHdrHi]                  ; +$058
    ld h,a                            ; +$05B
    ld d,a                            ; +$05C
    ld a,[hli]                        ; +$05D  5 header words (offsets from the header)
    ld [wMusCh1PtrLo],a               ; +$05E
    ld a,[hli]                        ; +$061
    ld [wMusCh1PtrHi],a               ; +$062
    ld a,[hli]                        ; +$065
    ld [wMusCh2PtrLo],a               ; +$066
    ld a,[hli]                        ; +$069
    ld [wMusCh2PtrHi],a               ; +$06A
    ld a,[hli]                        ; +$06D
    ld [wMusCh3PtrLo],a               ; +$06E
    ld a,[hli]                        ; +$071
    ld [wMusCh3PtrHi],a               ; +$072
    ld a,[hli]                        ; +$075
    ld [wMusCh4PtrLo],a               ; +$076
    ld a,[hli]                        ; +$079
    ld [wMusCh4PtrHi],a               ; +$07A
    ld a,[hli]                        ; +$07D  word 5 is stored lo/hi but read back hi/lo: never used
    ld [wMusEndPtrA],a                ; +$07E
    ld a,[hli]                        ; +$081
    ld [wMusEndPtrB],a                ; +$082
    ld a,[wMusCh1PtrHi]               ; +$085  track pointers += header address
    ld h,a                            ; +$088
    ld a,[wMusCh1PtrLo]               ; +$089
    ld l,a                            ; +$08C
    add hl,de                         ; +$08D
    ld a,h                            ; +$08E
    ld [wMusCh1PtrHi],a               ; +$08F
    ld a,l                            ; +$092
    ld [wMusCh1PtrLo],a               ; +$093
    ld a,[wMusCh2PtrHi]               ; +$096
    ld h,a                            ; +$099
    ld a,[wMusCh2PtrLo]               ; +$09A
    ld l,a                            ; +$09D
    add hl,de                         ; +$09E
    ld a,h                            ; +$09F
    ld [wMusCh2PtrHi],a               ; +$0A0
    ld a,l                            ; +$0A3
    ld [wMusCh2PtrLo],a               ; +$0A4
    ld a,[wMusCh3PtrHi]               ; +$0A7
    ld h,a                            ; +$0AA
    ld a,[wMusCh3PtrLo]               ; +$0AB
    ld l,a                            ; +$0AE
    add hl,de                         ; +$0AF
    ld a,h                            ; +$0B0
    ld [wMusCh3PtrHi],a               ; +$0B1
    ld a,l                            ; +$0B4
    ld [wMusCh3PtrLo],a               ; +$0B5
    ld a,[wMusCh4PtrHi]               ; +$0B8
    ld h,a                            ; +$0BB
    ld a,[wMusCh4PtrLo]               ; +$0BC
    ld l,a                            ; +$0BF
    add hl,de                         ; +$0C0
    ld a,h                            ; +$0C1
    ld [wMusCh4PtrHi],a               ; +$0C2
    ld a,l                            ; +$0C5
    ld [wMusCh4PtrLo],a               ; +$0C6
    ld a,[wMusEndPtrA]                ; +$0C9
    ld h,a                            ; +$0CC
    ld a,[wMusEndPtrB]                ; +$0CD
    ld l,a                            ; +$0D0
    add hl,de                         ; +$0D1
    ld a,h                            ; +$0D2
    ld [wMusEndPtrA],a                ; +$0D3
    ld a,l                            ; +$0D6
    ld [wMusEndPtrB],a                ; +$0D7
    xor a                             ; +$0DA  clear counters, end flags, modulation modes, pans (locks are kept)
    ld [wMusCh1Count],a               ; +$0DB
    ld [wMusCh2Count],a               ; +$0DE
    ld [wMusCh3Count],a               ; +$0E1
    ld [wMusCh4Count],a               ; +$0E4
    ld [wMusCh1End],a                 ; +$0E7
    ld [wMusCh2End],a                 ; +$0EA
    ld [wMusCh3End],a                 ; +$0ED
    ld [wMusCh4End],a                 ; +$0F0
    ld [wMusCh1ModMode],a             ; +$0F3
    ld [wMusCh2ModMode],a             ; +$0F6
    ld [wMusCh3ModMode],a             ; +$0F9
    ld [wMusCh1Pan],a                 ; +$0FC
    ld [wMusCh2Pan],a                 ; +$0FF
    ld [wMusCh3Pan],a                 ; +$102
    ld [wMusCh4Pan],a                 ; +$105
    xor a                             ; +$108
    ld [wMusBusy],a                   ; +$109
    ret                               ; +$10C

; Mus_Update: once per frame
Mus_Update:
    push af                           ; +$10D
    push bc                           ; +$10E
    push de                           ; +$10F
    push hl                           ; +$110
    ld a,[wMusBusy]                   ; +$111  C: skip while Mus_Init runs
    cp $01                            ; +$114
    jr z,.done                        ; +$116
    ld a,[wMusicId]                   ; +$118
    cp $FF                            ; +$11B
    jr z,.done                        ; +$11D
    call Mus_Ch1                      ; +$11F
    call Mus_Ch2                      ; +$122
    call Mus_Ch3                      ; +$125
    call Mus_Ch4                      ; +$128
    xor b                             ; +$12B  stray instruction, b is overwritten next
    ld a,[wMusCh1End]                 ; +$12C
    ld b,a                            ; +$12F
    ld a,[wMusCh2End]                 ; +$130
    or b                              ; +$133
    ld b,a                            ; +$134
    ld a,[wMusCh3End]                 ; +$135
    or b                              ; +$138
    ld b,a                            ; +$139
    ld a,[wMusCh4End]                 ; +$13A
    or b                              ; +$13D
    cp $FF                            ; +$13E  all four end flags set: $03|$0C|$30|$C0 = $FF
    jr nz,.done                       ; +$140
    ld [wMusicId],a                   ; +$142
.done:
    pop hl                            ; +$145  C: pops in reverse order (fixed)
    pop de                            ; +$146
    pop bc                            ; +$147
    pop af                            ; +$148
    ret                               ; +$149

; channel 1
Mus_Ch1:
    ld a,[wMusCh1End]                 ; +$14A
    cp $00                            ; +$14D
    jp nz,Mus_Ch1Ret                  ; +$14F
    ld a,[wMusCh1Count]               ; +$152
    cp $00                            ; +$155
    jp nz,Mus_Ch1Wait                 ; +$157
    ld a,[wMusCh1PtrHi]               ; +$15A
    ld b,a                            ; +$15D
    ld a,[wMusCh1PtrLo]               ; +$15E
    ld c,a                            ; +$161
    ld a,[bc]                         ; +$162  row byte
    cp $FF                            ; +$163
    jp z,Mus_Ch1CmdFF                 ; +$165
    cp $E0                            ; +$168
    jp z,Mus_Ch1Rest                  ; +$16A
    cp $F1                            ; +$16D
    jp z,Mus_Ch1CmdF1                 ; +$16F
    cp $F2                            ; +$172
    jp z,Mus_Ch1CmdF2                 ; +$174
    cp $F0                            ; +$177
    jp z,Mus_Ch1CmdF0                 ; +$179
    inc a                             ; +$17C  note: freq = FreqTable[note] (inc a + base FreqTable-2)
    ld hl,FreqTable - 2               ; +$17D
    ld e,a                            ; +$180
    ld d,$00                          ; +$181
    add hl,de                         ; +$183
    add hl,de                         ; +$184
    ld a,[hl]                         ; +$185
    ld [wMusCh1FreqLo],a              ; +$186
    inc hl                            ; +$189
    ld a,[hl]                         ; +$18A
    ld [wMusCh1FreqHi],a              ; +$18B
    inc bc                            ; +$18E
    ld a,[wCh1Lock]                   ; +$18F  lock 1: SFX owns the channel, write nothing
    cp $01                            ; +$192
    jr z,Mus_Ch1Length                ; +$194
    cp $02                            ; +$196
    call z,Mus_Ch1Restore             ; +$198  lock 2: restore the music instrument first
    ld a,[bc]                         ; +$19B  volume nibble -> NR12 bits 4-7
    swap a                            ; +$19C
    and $F0                           ; +$19E
    ld d,a                            ; +$1A0
    ldh a,[rNR12]                     ; +$1A1
    and $0F                           ; +$1A3
    or d                              ; +$1A5
    ldh [rNR12],a                     ; +$1A6
    ld a,[wMusCh1FreqLo]              ; +$1A8
    ldh [rNR13],a                     ; +$1AB
    ld a,[wMusCh1FreqHi]              ; +$1AD
    or $80                            ; +$1B0
    ldh [rNR14],a                     ; +$1B2

; row length byte; also restarts the pitch modulation
Mus_Ch1Length:
    inc bc                            ; +$1B4  length byte: row lasts that many frames
    ld a,[bc]                         ; +$1B5
    dec a                             ; +$1B6
    ld [wMusCh1Count],a               ; +$1B7
    inc bc                            ; +$1BA
    ld a,b                            ; +$1BB
    ld [wMusCh1PtrHi],a               ; +$1BC
    ld a,c                            ; +$1BF
    ld [wMusCh1PtrLo],a               ; +$1C0
    ld hl,wMusCh1ModBuf               ; +$1C3  restart the modulation list
    ld a,h                            ; +$1C6
    ld [wMusCh1ModPtrHi],a            ; +$1C7
    ld a,l                            ; +$1CA
    ld [wMusCh1ModPtrLo],a            ; +$1CB
    ld a,[wMusCh1ModDelayInit]        ; +$1CE
    ld [wMusCh1ModDelay],a            ; +$1D1
    ld a,[wMusCh1ModCountInit]        ; +$1D4
    ld [wMusCh1ModCount],a            ; +$1D7

Mus_Ch1Ret:
    ret                               ; +$1DA

; channel 2
Mus_Ch2:
    ld a,[wMusCh2End]                 ; +$1DB
    cp $00                            ; +$1DE
    jp nz,Mus_Ch2Ret                  ; +$1E0
    ld a,[wMusCh2Count]               ; +$1E3
    cp $00                            ; +$1E6
    jp nz,Mus_Ch2Wait                 ; +$1E8
    ld a,[wMusCh2PtrHi]               ; +$1EB
    ld b,a                            ; +$1EE
    ld a,[wMusCh2PtrLo]               ; +$1EF
    ld c,a                            ; +$1F2
    ld a,[bc]                         ; +$1F3
    cp $FF                            ; +$1F4
    jp z,Mus_Ch2CmdFF                 ; +$1F6
    cp $E0                            ; +$1F9
    jp z,Mus_Ch2Rest                  ; +$1FB
    cp $F1                            ; +$1FE
    jp z,Mus_Ch2CmdF1                 ; +$200
    cp $F2                            ; +$203
    jp z,Mus_Ch2CmdF2                 ; +$205
    cp $F0                            ; +$208
    jp z,Mus_Ch2CmdF0                 ; +$20A
    inc a                             ; +$20D
    ld hl,FreqTable - 2               ; +$20E
    ld e,a                            ; +$211
    ld d,$00                          ; +$212
    add hl,de                         ; +$214
    add hl,de                         ; +$215
    ld a,[hl]                         ; +$216
    ld [wMusCh2FreqLo],a              ; +$217
    inc hl                            ; +$21A
    ld a,[hl]                         ; +$21B
    ld [wMusCh2FreqHi],a              ; +$21C
    inc bc                            ; +$21F
    ld a,[wCh2Lock]                   ; +$220
    cp $01                            ; +$223
    jr z,Mus_Ch2Length                ; +$225
    cp $02                            ; +$227
    call z,Mus_Ch2Restore             ; +$229
    ld a,[bc]                         ; +$22C
    swap a                            ; +$22D
    and $F0                           ; +$22F
    ld d,a                            ; +$231
    ldh a,[rNR22]                     ; +$232
    and $0F                           ; +$234
    or d                              ; +$236
    ldh [rNR22],a                     ; +$237
    ld a,[wMusCh2FreqLo]              ; +$239
    ldh [rNR23],a                     ; +$23C
    ld a,[wMusCh2FreqHi]              ; +$23E
    or $80                            ; +$241
    ldh [rNR24],a                     ; +$243

Mus_Ch2Length:
    inc bc                            ; +$245
    ld a,[bc]                         ; +$246
    dec a                             ; +$247
    ld [wMusCh2Count],a               ; +$248
    inc bc                            ; +$24B
    ld a,b                            ; +$24C
    ld [wMusCh2PtrHi],a               ; +$24D
    ld a,c                            ; +$250
    ld [wMusCh2PtrLo],a               ; +$251
    ld hl,wMusCh2ModBuf               ; +$254
    ld a,h                            ; +$257
    ld [wMusCh2ModPtrHi],a            ; +$258
    ld a,l                            ; +$25B
    ld [wMusCh2ModPtrLo],a            ; +$25C
    ld a,[wMusCh2ModDelayInit]        ; +$25F
    ld [wMusCh2ModDelay],a            ; +$262
    ld a,[wMusCh2ModCountInit]        ; +$265
    ld [wMusCh2ModCount],a            ; +$268

Mus_Ch2Ret:
    ret                               ; +$26B

; channel 3
Mus_Ch3:
    ld a,[wMusCh3End]                 ; +$26C
    cp $00                            ; +$26F
    jp nz,Mus_Ch3Ret                  ; +$271
    ld a,[wMusCh3Count]               ; +$274
    cp $00                            ; +$277
    jp nz,Mus_Ch3Wait                 ; +$279
    ld a,[wMusCh3PtrHi]               ; +$27C
    ld b,a                            ; +$27F
    ld a,[wMusCh3PtrLo]               ; +$280
    ld c,a                            ; +$283
    ld a,[bc]                         ; +$284
    cp $FF                            ; +$285
    jp z,Mus_Ch3CmdFF                 ; +$287
    cp $E0                            ; +$28A
    jp z,Mus_Ch3Rest                  ; +$28C
    cp $F1                            ; +$28F
    jp z,Mus_Ch3CmdF1                 ; +$291
    cp $F2                            ; +$294
    jp z,Mus_Ch3CmdF2                 ; +$296
    cp $F0                            ; +$299
    jp z,Mus_Ch3CmdF0                 ; +$29B
    inc a                             ; +$29E
    ld hl,FreqTable - 2               ; +$29F
    ld e,a                            ; +$2A2
    ld d,$00                          ; +$2A3
    add hl,de                         ; +$2A5
    add hl,de                         ; +$2A6
    ld a,[hl]                         ; +$2A7
    ld [wMusCh3FreqLo],a              ; +$2A8
    inc hl                            ; +$2AB
    ld a,[hl]                         ; +$2AC
    ld [wMusCh3FreqHi],a              ; +$2AD
    xor a                             ; +$2B0  NR30/NR31 cleared even when SFX owns ch3
    ldh [rNR30],a                     ; +$2B1
    ldh [rNR31],a                     ; +$2B3
    inc bc                            ; +$2B5  volume byte is skipped on ch3
    ld a,[wCh3Lock]                   ; +$2B6
    cp $01                            ; +$2B9
    jr z,Mus_Ch3Length                ; +$2BB
    cp $02                            ; +$2BD
    call z,Mus_Ch3Restore             ; +$2BF
    ld a,[wMusCh3Level]               ; +$2C2
    ldh [rNR32],a                     ; +$2C5
    ld a,[wMusCh3FreqLo]              ; +$2C7
    ldh [rNR33],a                     ; +$2CA
    ld a,$80                          ; +$2CC
    ldh [rNR30],a                     ; +$2CE
    ld a,[wMusCh3FreqHi]              ; +$2D0
    or $80                            ; +$2D3
    ldh [rNR34],a                     ; +$2D5

Mus_Ch3Length:
    inc bc                            ; +$2D7
    ld a,[bc]                         ; +$2D8
    dec a                             ; +$2D9
    ld [wMusCh3Count],a               ; +$2DA
    inc bc                            ; +$2DD
    ld a,b                            ; +$2DE
    ld [wMusCh3PtrHi],a               ; +$2DF
    ld a,c                            ; +$2E2
    ld [wMusCh3PtrLo],a               ; +$2E3
    ld hl,wMusCh3ModBuf               ; +$2E6
    ld a,h                            ; +$2E9
    ld [wMusCh3ModPtrHi],a            ; +$2EA
    ld a,l                            ; +$2ED
    ld [wMusCh3ModPtrLo],a            ; +$2EE
    ld a,[wMusCh3ModDelayInit]        ; +$2F1
    ld [wMusCh3ModDelay],a            ; +$2F4
    ld a,[wMusCh3ModCountInit]        ; +$2F7
    ld [wMusCh3ModCount],a            ; +$2FA

Mus_Ch3Ret:
    ret                               ; +$2FD

; channel 4
Mus_Ch4:
    ld a,[wMusCh4End]                 ; +$2FE
    cp $00                            ; +$301
    jp nz,Mus_Ch4Ret                  ; +$303
    ld a,[wMusCh4Count]               ; +$306
    cp $00                            ; +$309
    jp nz,Mus_Ch4Wait                 ; +$30B
    ld a,[wMusCh4PtrHi]               ; +$30E
    ld b,a                            ; +$311
    ld a,[wMusCh4PtrLo]               ; +$312
    ld c,a                            ; +$315
    ld a,[bc]                         ; +$316
    cp $FF                            ; +$317
    jp z,Mus_Ch4CmdFF                 ; +$319
    cp $E0                            ; +$31C
    jp z,Mus_Ch4Rest                  ; +$31E
    cp $F1                            ; +$321
    jp z,Mus_Ch4CmdF1                 ; +$323
    cp $F0                            ; +$326
    jp nz,Mus_Ch4Note                 ; +$328
    inc bc                            ; +$32B  $F0 on ch4: pointer is not stored, so this hangs
    inc bc                            ; +$32C
    jp Mus_Ch4                        ; +$32D

Mus_Ch4Note:
    call Mus_Ch4LoadDrum              ; +$330
    ld hl,FreqTable - 2               ; +$333  leftover: hl is not used
    inc bc                            ; +$336
    ld a,[wCh4Lock]                   ; +$337
    cp $01                            ; +$33A
    jr z,Mus_Ch4Length                ; +$33C
    cp $02                            ; +$33E
    call z,Mus_Ch4Restore             ; +$340
    ld a,[bc]                         ; +$343
    swap a                            ; +$344
    and $F0                           ; +$346
    ld d,a                            ; +$348
    ldh a,[rNR42]                     ; +$349
    and $0F                           ; +$34B
    or d                              ; +$34D
    ldh [rNR42],a                     ; +$34E
    ld a,[wMusCh4NR44]                ; +$350
    or $80                            ; +$353
    ldh [rNR44],a                     ; +$355

Mus_Ch4Length:
    inc bc                            ; +$357
    ld a,[bc]                         ; +$358
    dec a                             ; +$359
    ld [wMusCh4Count],a               ; +$35A
    inc bc                            ; +$35D
    ld a,b                            ; +$35E
    ld [wMusCh4PtrHi],a               ; +$35F
    ld a,c                            ; +$362
    ld [wMusCh4PtrLo],a               ; +$363

Mus_Ch4Ret:
    ret                               ; +$366

; $E0: rest
Mus_Ch1Rest:
    ld a,[wMusCh1RestNR14]            ; +$367
    cp $00                            ; +$36A  rest byte 0: nothing to do, the note keeps sounding
    jp z,Mus_Ch1Length                ; +$36C
    ld a,[wCh1Lock]                   ; +$36F
    cp $01                            ; +$372
    jp z,Mus_Ch1Length                ; +$374
    xor a                             ; +$377  NR12 = 0 turns the DAC off; the rewrite does not retrigger unless bit 7 is set
    ldh [rNR12],a                     ; +$378
    ld a,[wMusCh1Env]                 ; +$37A
    ldh [rNR12],a                     ; +$37D
    ld a,[wMusCh1RestNR14]            ; +$37F
    ldh [rNR14],a                     ; +$382
    jp Mus_Ch1Length                  ; +$384

; $E0: rest
Mus_Ch2Rest:
    ld a,[wMusCh2RestNR24]            ; +$387
    cp $00                            ; +$38A
    jp z,Mus_Ch2Length                ; +$38C
    ld a,[wCh2Lock]                   ; +$38F
    cp $01                            ; +$392
    jp z,Mus_Ch2Length                ; +$394
    xor a                             ; +$397
    ldh [rNR22],a                     ; +$398
    ld a,[wMusCh2Env]                 ; +$39A
    ldh [rNR22],a                     ; +$39D
    ld a,[wMusCh2RestNR24]            ; +$39F
    ldh [rNR24],a                     ; +$3A2
    jp Mus_Ch2Length                  ; +$3A4

; $E0: rest
Mus_Ch3Rest:
    ld a,[wMusCh3RestFlag]            ; +$3A7
    cp $00                            ; +$3AA
    jp z,Mus_Ch3Length                ; +$3AC
    ld a,[wCh3Lock]                   ; +$3AF
    cp $01                            ; +$3B2
    jp z,Mus_Ch3Length                ; +$3B4
    xor a                             ; +$3B7
    ldh [rNR30],a                     ; +$3B8
    jp Mus_Ch3Length                  ; +$3BA

; $E0: rest
Mus_Ch4Rest:
    ld a,[wMusCh4NR44]                ; +$3BD
    cp $00                            ; +$3C0
    jp z,Mus_Ch4Length                ; +$3C2
    ld a,[wCh4Lock]                   ; +$3C5
    cp $01                            ; +$3C8
    jp z,Mus_Ch4Length                ; +$3CA
    xor a                             ; +$3CD
    ldh [rNR42],a                     ; +$3CE
    ldh [rNR43],a                     ; +$3D0
    ld a,[wMusCh4NR42]                ; +$3D2
    ldh [rNR42],a                     ; +$3D5
    ld a,[wMusCh4NR43]                ; +$3D7
    ldh [rNR43],a                     ; +$3DA
    ld a,[wMusCh4NR44]                ; +$3DC
    ldh [rNR44],a                     ; +$3DF
    jp Mus_Ch4Length                  ; +$3E1

; row still running: count down, then modulation
Mus_Ch1Wait:
    dec a                             ; +$3E4
    ld [wMusCh1Count],a               ; +$3E5
    ld a,[wCh1Lock]                   ; +$3E8  C: modulation stops only for lock 1
    cp $01                            ; +$3EB
    jr z,Mus_Ch1WaitDone              ; +$3ED

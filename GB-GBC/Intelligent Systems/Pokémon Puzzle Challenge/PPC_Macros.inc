DEF REST EQU $D2  ; release the note (envelope release), wait
DEF HOLD EQU $D3  ; keep the note sounding, wait

; ---- music commands ($D2-$FF, $00) ----
MACRO SONG_ENTRY        ; song table entry: pointer + bank
	dw \1
	db BANK(\1)
ENDM
MACRO SONG_HEADER       ; ch1, ch2, ch3, ch4 track pointers (0 = channel unused)
	dw \1, \2, \3, \4
ENDM
MACRO TRACK_END
	db $00
ENDM
MACRO PITCHMAC          ; pitch macro n (PitchMacroTable), restarted at every note
	db $D4, \1
ENDM
MACRO PITCHMAC_OFF
	db $D5
ENDM
MACRO TEMPO             ; ticks per frame = n / 30 (global)
	db $D6, \1
ENDM
MACRO TRANSPOSE         ; semitones
	db $D7, LOW(\1)
ENDM
MACRO ENVELOPE          ; envelope pair n (EnvelopeTable)
	db $D8, \1
ENDM
MACRO ENVELOPE_OFF
	db $D9
ENDM
MACRO MASTERVOL         ; NR50
	db $DA, \1
ENDM
MACRO PAN_RIGHT
	db $DB
ENDM
MACRO PAN_LEFT
	db $DC
ENDM
MACRO PAN_CENTRE
	db $DD
ENDM
MACRO DUTY              ; 0-3
	db $DE + (\1)
ENDM
MACRO WAVE              ; ch3 wave n (MusicWaves), loaded at once
	db $E2, \1
ENDM
MACRO DETUNE            ; signed, added to the hardware period
	db $E3, LOW(\1)
ENDM
MACRO PITCH_DETUNE      ; signed, added to the pitch (1/8 semitone) before the period lookup
	db $E4, LOW(\1)
ENDM
MACRO GATE              ; release when n ticks of the note are left
	db $E5, \1
ENDM
MACRO NRX2              ; write NRx2 directly
	db $E6, \1
ENDM
MACRO GOTO
	db $E7
	dw \1
ENDM
MACRO LOOP              ; counter 1-4, count, target (unused by the songs)
	db $E7 + (\1), \2
	dw \3
ENDM
MACRO GOSUB
	db $EC
	dw \1
ENDM
MACRO RETSUB
	db $ED
ENDM
MACRO NUDGE             ; -8..-1, 1..8 eighths of a semitone, no retrigger, wait
	IF (\1) < 0
		db $F6 + (\1)
	ELSE
		db $F5 + (\1)
	ENDC
ENDM
MACRO RETRIG            ; retrigger the current pitch, wait
	db $FE
ENDM
MACRO SLIDE             ; ticks, semitones, step per tick (8.8 fixed, in 1/8 semitones)
	db $FF, \1, LOW(\2)
	dw \3
ENDM

; ---- instrument data (bank $20) ----
MACRO ENV_ENTRY         ; attack sequence, release sequence (0 = none)
	dw \1, \2
ENDM
MACRO ENV_VOL           ; NRx2 value, written with a retrigger
	REPT _NARG
		db \1
		SHIFT
	ENDR
ENDM
MACRO ENV_LEN           ; NRx1 length (bits 0-5; bit 6 is ignored, bit 7 marks the byte)
	REPT _NARG
		db $80 | (\1)
		SHIFT
	ENDR
ENDM
MACRO ENV_WAIT          ; frames this step lasts
	REPT _NARG
		db \1
		SHIFT
	ENDR
ENDM
MACRO ENV_END
	db $00
ENDM
MACRO PM_SPEED          ; ticks between deltas (1-99)
	REPT _NARG
		db \1
		SHIFT
	ENDR
ENDM
MACRO PM_DELTA          ; add d/8 semitone to the pitch, then wait PM_SPEED ticks
	REPT _NARG
		db (\1) + $85
		SHIFT
	ENDR
ENDM
MACRO PM_GOTO
	db $64
	dw \1
ENDM
MACRO PM_END
	db $00
ENDM

; ---- PCM ----
MACRO PCM_ENTRY         ; sample, length in bytes
	dw \1
	db BANK(\1)
	dw \2
ENDM

; ---- SFX engine A (bank $21) ----
MACRO SFX_PTR           ; priority 0-3, stream (0 = none)
	dw ((\2) & $3FFF) | ((\1) << 14)
ENDM
MACRO SFXM_ENTRY        ; priority, ch1, ch2, ch3, ch4
	SFX_PTR \1, \2
	SFX_PTR \1, \3
	SFX_PTR \1, \4
	SFX_PTR \1, \5
ENDM
; stream bytes: $01-$89 wait n frames, $8A-$D1 set note (no trigger), $00 or $D2-$DF end
MACRO SFX_END
	db $00
ENDM
MACRO SFX_CALL
	db $E0
	dw \1
ENDM
MACRO SFX_RET
	db $E1
ENDM
MACRO SFX_LOOP          ; count (0 = forever)

; Mole Mania sound driver code, $4000-$4F36 (identical in banks $07, $0B and $1A).
; Every table address it uses is a label, so the three banks assemble from this one file.
; Generated by tools/mmgen.py from the ROM; edit freely, build_check.sh verifies.

; Entry 1 ($4000): initialise the sound hardware.
Sound_Init:
	jr InitHardware

; Entry 2 ($4002): once per frame. The game copies its requests into
; wSongRequest/wCommandRequest/wSfxStopMask first (home bank $0463).
Sound_Update:
	call HandleSongRequest
	xor a
	ld [wSongRequest], a
	call HandleCommandRequest
	xor a
	ld [wCommandRequest], a
	call HandleSfxRequests
	xor a
	ld hl, wSfxRequestBits
	ld [hli], a
	ld [hli], a
	ld [hli], a
	ld [hli], a
	ld [hli], a
	ld [hli], a
	ld [hli], a
	ld [hli], a
	ld [hli], a
	ld [hli], a
	ld [hl], a
	call HandleSfxStopMask
	xor a
	ld [wSfxStopMask], a
	call HandleCommand
	xor a
	ld [wCommand], a
	ld a, [wSystemFlags]
	rlca
	jr nc, .l406B
	ld a, [wCurSong]
	cp $06
	jr nz, .l4044
	ld a, [wGameD23B]
	cp $01
	jr z, .l406B
.l4044:
	ld a, [wCh3Decay+2]
	cp $01
	jr nz, .l405B
	ld a, [wWave]
	cp $01
	jr nz, .l405B
	ld a, [wNoteFrames+2]
	cp $02
	jr nz, .l405B
	jr .l406B
.l405B:
	ld a, [wSgbSkipCounter]
	inc a
	ld [wSgbSkipCounter], a
	cp $2B
	jr nz, .l406B
	xor a
	ld [wSgbSkipCounter], a
	ret
.l406B:
	call Music_Update
	jp Sfx_Update

InitHardware:
	ld a, $80
	ldh [rNR52], a
	ld a, $FF
	ldh [rNR51], a
	ld [wNR51], a
	ld a, $08
	ldh [rNR10], a
	xor a
	ldh [rNR11], a
	ldh [rNR12], a
	ldh [rNR13], a
	ldh [rNR14], a
	ldh [rNR21], a
	ldh [rNR22], a
	ldh [rNR23], a
	ldh [rNR24], a
	ldh [rNR30], a
	ldh [rNR31], a
	ldh [rNR32], a
	ldh [rNR33], a
	ldh [rNR34], a
	ldh [rNR41], a
	ldh [rNR42], a
	ldh [rNR43], a
	ldh [rNR44], a
	ld a, $77
	ldh [rNR50], a
	ret

HandleSongRequest:
	ld b, $00
	ld a, [wSongRequest]
	and a
	ret z
	ld [wCurSong], a
	dec a
	rlca
	ld c, a
	ld b, $00
	ld hl, SongTable
	add hl, bc
	ld a, [hli]
	ld [wSongPtr], a
	ld a, [hl]
	ld [wSongPtr+1], a
	jp StartSong

HandleCommandRequest:
	ld b, $00
	ld a, [wCommandRequest]
	and a
	ret z
.l40CD:
	rrca
	inc b
	jr nc, .l40CD
	ld a, b
	ld [wCommand], a
	ret

HandleSfxRequests:
	ld b, $00
	ld c, $00
.l40DA:
	ld d, $00
	ld e, $00
	xor a
	ld [wTemp], a
	ld hl, wSfxRequestBits
	add hl, bc
	ld a, [hl]
	and a
	jr z, .l4122
	ld [wTemp], a
.l40ED:
	ld a, [wTemp]
	rrca
	ld [wTemp], a
	jr nc, .l411C
	push bc
	ld a, $08
	ld h, a
	call Mul8x8
	ld a, l
	add a, e
	inc a
	push af
	dec a
	rlca
	ld c, a
	ld b, $00
	ld hl, SfxTable
	add hl, bc
	ld a, [hli]
	ld b, a
	ld a, [hl]
	ld c, a
	ld a, [bc]
	ld b, $00
	ld c, a
	ld hl, wSfxRequest
	add hl, bc
	pop af
	ld [hl], a
	call FilterSfxRequest
	pop bc
.l411C:
	inc e
	ld a, e
	cp $08
	jr nz, .l40ED
.l4122:
	inc c
	ld a, c
	cp $0B
	jr nz, .l40DA
	ret

FilterSfxRequest:
	call Filter_Ch4
	call Filter_Ch2
	call Filter_Ch3
	jr Filter_Priority

Filter_Ch4:
	ld hl, wSfxRequest+3
	ld a, [hl]
	cp $1A
	ret nz
	ld hl, wSfxId+3
	ld a, [hl]
	cp $0C
	jr z, CancelSfxRequest
	ret

Filter_Ch2:
	ld hl, wSfxRequest+1
	ld a, [hl]
	cp $0A
	ret nz
	ld hl, wSfxId+1
	ld a, [hl]
	and a
	jr nz, CancelSfxRequest
	ret

Filter_Ch3:
	ld hl, wSfxRequest+2
	ld a, [hl]
	cp $04
	ret nz
	ld hl, wSfxId+2
	ld a, [hl]
	cp $0B
	jr z, CancelSfxRequest
	cp $10
	jr z, CancelSfxRequest
	cp $04
	jr z, CancelSfxRequest
	ret

Filter_Priority:
	ld hl, wSfxId
	add hl, bc
	ld a, [hl]
	cp $28
	jr z, CancelSfxRequest
	cp $24
	jr z, CancelSfxRequest
	cp $25
	jr z, CancelSfxRequest
	ret

CancelSfxRequest:
	ld hl, wSfxRequest
	add hl, bc
	xor a
	ld [hl], a
	ret

HandleSfxStopMask:
	ld a, [wSfxStopMask]
	and a
	ret z
	rrca
	call c, StopSfx_Ch1
	rrca
	call c, StopSfx_Ch2
	rrca
	call c, StopSfx_Ch3
	rrca
	call c, StopSfx_Ch4
	rrca
	call c, StopSfx_Bit4
	rrca
	call c, StopSfx_Bit5
	rrca
	call c, StopSfx_Bit6
	rrca
	ret nc
	ret

StopSfx_Ch1:
	push af
	ld a, [wSfxId]
	and a
	jr z, .l41B8
	xor a
	ldh [rNR12], a
	ld [wSfxRequest], a
	ld [wSfxId], a
.l41B8:
	pop af
	ret

StopSfx_Ch2:
	push af
	ld a, [wSfxId+1]
	and a
	jr z, .l41CA
	xor a
	ldh [rNR22], a
	ld [wSfxRequest+1], a
	ld [wSfxId+1], a
.l41CA:
	pop af
	ret

StopSfx_Ch3:
	push af
	ld a, [wSfxId+2]
	and a
	jr z, .l41DE
	xor a
	ldh [rNR32], a
	ldh [rNR30], a
	ld [wSfxRequest+2], a
	ld [wSfxId+2], a
.l41DE:
	pop af
	ret

StopSfx_Ch4:
	push af
	ld a, [wSfxId+3]
	and a
	jr z, .l41F0
	xor a
	ldh [rNR42], a
	ld [wSfxRequest+3], a
	ld [wSfxId+3], a
.l41F0:
	pop af
	ret

StopSfx_Bit4:
	ret

StopSfx_Bit5:
	ret

StopSfx_Bit6:
	ret

HandleCommand:
	ld a, [wCommand]
	and a
	ret z
	cp $01
	jr z, Cmd_Stop
	cp $02
	jr z, Cmd_Pause
	cp $03
	jr z, Cmd_Resume
	ret

Cmd_Pause:
	ld a, $01
	ld [wPaused], a
	ld hl, wSaveSongVars
	ld de, wCurSong
	ld a, [de]
	ld [hli], a
	inc de
	ld a, [de]
	ld [hli], a
	inc de
	ld a, [de]
	ld [hli], a
	inc de
	ld a, [de]
	ld [hli], a
	inc de
	ld a, [de]
	ld [hli], a
	inc de
	ld a, [de]
	ld [hli], a
	inc de
	ld a, [de]
	ld [hli], a
	inc de
	ld a, [de]
	ld [hli], a
	inc de
	ld a, [de]
	ld [hl], a
	ld c, $A4
	ld hl, wFreqHi
.l4231:
	ld a, [hl]
	dec h
	ld [hli], a
	inc h
	dec c
	jr nz, .l4231
	call SilenceMusic
	xor a
	ld [wCurSong], a
	ret

Cmd_Stop:
	xor a
	ld [wPaused], a
	inc a
	ld [wStopFlag], a
	ret

Cmd_Resume:
	xor a
	ld [wPaused], a
	ld hl, wCurSong
	ld de, wSaveSongVars
	ld a, [de]
	ld [hli], a
	inc de
	ld a, [de]
	ld [hli], a
	inc de
	ld a, [de]
	ld [hli], a
	inc de
	ld a, [de]
	ld [hli], a
	inc de
	ld a, [de]
	ld [hli], a
	inc de
	ld a, [de]
	ld [hli], a
	inc de
	ld a, [de]
	ld [hli], a
	inc de
	ld a, [de]
	ld [hli], a
	inc de
	ld a, [de]
	ld [hl], a
	ld d, $00
	ld e, $00
.l4271:
	ld hl, wSaveChannelVars
	add hl, de
	ld a, [hl]
	ld hl, wFreqHi
	add hl, de
	ld [hl], a
	inc e
	ld a, e
	cp $A4
	jr nz, .l4271
	ret

; Music: on SGB the caller skips this (and the SFX update) one frame in 43.
Music_Update:
	ld a, [wStopFlag]
	and a
	jr nz, .l428A
	jr Music_Play
.l428A:
	call SilenceMusic
	xor a
	ld [wCurSong], a
	ld [wCommand], a
	ld [wStopFlag], a
	ret

Music_Play:
	ld a, [wCurSong]
	and a
	ret z
	ld d, $00
	ld e, $00
.l42A1:
	call LoadFrame
	ld hl, wChActive
	add hl, de
	jr z, .l42C8
	call Music_ReadEvent
	call Fx_Scoop
	call Fx_Porta
	call Fx_Vibrato
	call Fx_DutySeq
	call Fx_EnvSeq
	call Fx_Release
	call Music_Output
	call CountNoteFrames
	call Fx_Pan
.l42C8:
	inc e
	ld a, e
	cp $04
	jr nz, .l42A1
	ret

CountNoteFrames:
	ld hl, wNoteFrames
	add hl, de
	ld a, [hl]
	and a
	ret z
	cp $FF
	jr z, .l42DB
	inc a
.l42DB:
	ld [hl], a
	ret

; Read the event at the channel position. Commands are consumed here;
; the position stays on the note/rest until its length runs out.
Music_ReadEvent:
	call Pat_Read
	jr Music_NextByte.l42E5

Music_NextByte:
	call Pat_IncRead
.l42E5:
	ld b, a
	sub $20
	jr c, Ev_Command
	ld a, b
	sub $2C
	jr c, Ev_Length
	ld a, b
	sub $30
	jr c, Ev_Ch3Level
	ld a, b
	sub $70
	jr c, Ev_Gate
	ld a, b
	jp Ev_Note

Ev_Gate:
	ld a, b
	sub $30
	rlca
	rlca
	ld hl, wGate
	add hl, de
	ld [hl], a
	jr Music_NextByte

Ev_Ch3Level:
	ld a, b
	sub $2C
	ld [wCh3Level], a
	jr Music_NextByte

Ev_Length:
	ld a, b
	sub $20
	ld c, a
	ld b, $00
	push bc
	ld hl, LengthTables
	ld a, [wTempo]
	rlca
	ld c, a
	ld b, $00
	add hl, bc
	ld a, [hli]
	ld b, a
	ld a, [hl]
	ld l, a
	ld h, b
	pop bc
	add hl, bc
	ld a, [hl]
.l432B:
	ld hl, wLength
	add hl, de
	ld [hl], a
	ld hl, wLenCounter
	add hl, de
	ld [hl], a
	jr Music_NextByte

Ev_Command:
	ld a, b
	rlca
	ld c, a
	ld b, $00
	ld hl, MusicCommandTable
	add hl, bc
	ld a, [hli]
	ld l, [hl]
	ld h, a
	jp hl

MusicCommandTable:
	dwb Cmd00_PatEnd
	dwb Cmd01_Tempo
	dwb Cmd02_Wave
	dwb Cmd03_Vibrato
	dwb Cmd04_VibratoOff
	dwb Cmd05_Release
	dwb Cmd06_ReleaseOff
	dwb Cmd07_Porta
	dwb Cmd08_Frames
	dwb Cmd09_Transpose
	dwb Cmd0A_PanCentre
	dwb Cmd0B_PanRight
	dwb Cmd0C_PanLeft
	dwb Cmd0D_Frames
	dwb Cmd0E_Ch3Decay
	dwb Cmd0F_Scoop
	dwb Cmd10_DutySeq
	dwb Cmd11_EnvSeq
	dwb Cmd12_PortaOff
	dwb Cmd13_ScoopOff
	dwb Music_NextByte
	dwb Music_NextByte
	dwb Music_NextByte
	dwb Music_NextByte
	dwb Music_NextByte
	dwb Music_NextByte
	dwb Music_NextByte
	dwb Music_NextByte
	dwb Music_NextByte
	dwb Music_NextByte
	dwb Music_NextByte
	dwb Music_NextByte

Pat_IncRead:
	ld hl, wPatPos
	add hl, de
	inc [hl]

Pat_Read:
	ld hl, wPatPos
	add hl, de
	ld a, [hl]
	ld c, a
	ld b, $00
	ld a, [wFramePtr]
	ld h, a
	ld a, [wFramePtr+1]
	ld l, a
	add hl, bc
	ld a, [hl]
	ret

Cmd10_DutySeq:
	call Pat_IncRead
	ld hl, wDutySeq
	add hl, de
	ld [hl], a
	jp Music_NextByte

Cmd11_EnvSeq:
	call Pat_IncRead
	ld hl, wEnvSeq
	add hl, de
	ld [hl], a
	jp Music_NextByte

Cmd0F_Scoop:
	call Pat_IncRead
	ld hl, wScoop
	add hl, de
	ld [hl], a
	jp Music_NextByte

Cmd0E_Ch3Decay:
	call Pat_IncRead
	ld hl, wCh3Decay
	add hl, de
	ld [hl], a
	jp Music_NextByte

Cmd0D_Frames:
	call Pat_IncRead
	jp Ev_Length.l432B

Cmd0A_PanCentre:
	ld hl, wPan
	add hl, de
	xor a
	ld [hl], a
	jp Music_NextByte

Cmd0B_PanRight:
	ld hl, wPan
	add hl, de
	ld a, $01
	ld [hl], a
	jp Music_NextByte

Cmd0C_PanLeft:
	ld hl, wPan
	add hl, de
	ld a, $02
	ld [hl], a
	jp Music_NextByte

Cmd09_Transpose:
	call Pat_IncRead
	ld hl, wTranspose
	add hl, de
	ld [hl], a
	jp Music_NextByte

Cmd08_Frames:
	call Pat_IncRead
	jp Ev_Length.l432B

Cmd00_PatEnd:
	ld a, [wStepIndex]
	inc a
	ld [wStepIndex], a
	push de
	ld d, $00
	ld e, $00
.l4408:
	xor a
	ld hl, wPatPos
	add hl, de
	ld [hl], a
	ld hl, wNoteFrames
	add hl, de
	ld [hl], a
	ld hl, wPortaFrames
	add hl, de
	ld [hl], a
	inc e
	ld a, e
	cp $04
	jr nz, .l4408
	pop de
	call LoadFrame
	call CheckSongEnd
	jp Music_ReadEvent

Cmd01_Tempo:
	call Pat_IncRead
	ld [wTempo], a
	jp Music_NextByte

Cmd02_Wave:
	call Pat_IncRead
	ld [wWave], a
	jp Music_NextByte

Cmd03_Vibrato:
	call Pat_IncRead
	ld hl, wVibDelay
	add hl, de
	ld [hl], a
	call Pat_IncRead
	ld hl, wVibRate
	add hl, de
	ld [hl], a
	call Pat_IncRead
	ld hl, wVibDepth
	add hl, de
	ld [hl], a
	ld a, $01
	ld hl, wVibState
	add hl, de

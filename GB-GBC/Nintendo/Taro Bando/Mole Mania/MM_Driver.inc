Music_GateOff:
	call Pat_IncRead
	cp $BA
	jr nz, .l4562
	ld a, $01
	ld hl, wTieFlag
	add hl, de
	ld [hl], a
	ret
.l4562:
	ld hl, wPatPos
	add hl, de
	dec [hl]
	ld a, [wTemp]
	and a
	ret z
	ld hl, wRelFrames
	add hl, de
	ld a, [hl]
	and a
	jr z, MuteChannel
	ld hl, wRelTimer
	add hl, de
	ld a, $01
	ld [hl], a
	ret

MuteChannel:
	ld a, e
	and a
	jp z, Silence_Ch1
	cp $01
	jp z, Silence_Ch2
	cp $02
	jp z, Silence_Ch3
	cp $03
	jp z, Silence_Ch4

; A = note index (byte - $70) -> BC = period, from the DMG or the SGB
; table depending on wSystemFlags bit 7. Ch4 returns at once.
GetNotePeriod:
	ld b, a
	ld a, e
	cp $03
	ret z
	ld hl, wTranspose
	add hl, de
	ld a, [hl]
	add a, b
	rlca
	ld c, a
	ld b, $00
	ld a, [wSystemFlags]
	rlca
	jr c, .l45AE
	ld hl, FreqTable_DMG
	add hl, bc
	ld a, [hli]
	ld b, a
	ld a, [hl]
	ld c, a
	ret
.l45AE:
	ld hl, FreqTable_SGB
	add hl, bc
	ld a, [hli]
	ld b, a
	ld a, [hl]
	ld c, a
	ret

Fx_Scoop:
	ld hl, wFreqHi
	add hl, de
	ld a, [hl]
	ld b, a
	ld hl, wFreqLo
	add hl, de
	ld a, [hl]
	ld c, a
	push bc
	ld hl, wScoop
	add hl, de
	ld a, [hl]
	and a
	jr z, .l45FC
	push af
	and $0F
	ld [wTemp], a
	pop af
	swap a
	and $0F
	ld [wTemp+1], a
	ld hl, wNoteFrames
	add hl, de
	ld a, [hl]
	and a
	jr z, .l45FC
	ld b, a
	ld a, [wTemp]
	sub b
	jr c, .l45FC
	and a
	jr z, .l45FC
	ld h, a
	ld a, [wTemp+1]
	ld c, a
	call Mul8x8
	ld a, l
	pop bc
.l45F6:
	dec bc
	dec a
	jr nz, .l45F6
	jr .l45FD
.l45FC:
	pop bc
.l45FD:
	ld hl, wFreqHi
	add hl, de
	ld a, b
	ld [hl], a
	ld hl, wFreqLo
	add hl, de
	ld a, c
	ld [hl], a
	ret

Fx_DutySeq:

Ev_Note:
	ld a, b
	sub $70
	ld [wTemp], a
	cp $4A
	jp z, .l44F3
	ld a, e
	cp $03
	jr nz, .l44DE
	ld a, b
	sub $BC
	ld c, a
	ld b, $00
	ld hl, NoiseTable
	add hl, bc
	ld a, [hl]
	ld [wNoiseNR43], a
	jp .l44F3
.l44DE:
	ld a, [wTemp]
	and a
	jr z, .l44F3
	call GetNotePeriod
	ld hl, wFreqHi
	add hl, de
	ld a, b
	ld [hl], a
	ld hl, wFreqLo
	add hl, de
	ld a, c
	ld [hl], a
.l44F3:
	call CalcGateFrames
	ld hl, wLength
	add hl, de
	ld a, [hl]
	ld hl, wGateFrames
	add hl, de
	sub [hl]
	ld hl, wLenCounter
	add hl, de
	cp [hl]
	jr nz, .l450A
	call Music_GateOff
.l450A:
	ld hl, wLenCounter
	add hl, de
	ld a, [hl]
	cp $01
	jr z, .l4543
	ld hl, wLength
	add hl, de
	cp [hl]
	jr z, .l4520
.l451A:
	ld hl, wLenCounter
	add hl, de
	dec [hl]
	ret
.l4520:
	ld a, [wTemp]
	and a
	jr z, .l4541
	ld hl, wTieFlag
	add hl, de
	ld a, [hl]
	and a
	jr z, .l4532
	xor a
	ld [hl], a
	jr .l4541
.l4532:
	ld a, $01
	ld hl, wTrigger
	add hl, de
	ld [hl], a
	ld hl, wDutyDirty
	add hl, de
	ld [hl], a
	call TriggerNote
.l4541:
	jr .l451A
.l4543:
	ld hl, wPatPos
	add hl, de
	inc [hl]
	ld hl, wLength
	add hl, de
	ld a, [hl]
	ld hl, wLenCounter
	add hl, de

; Mole Mania (Taro Bando) sound driver: data macros and constants

IF !DEF(MM_MACROS_INC)
DEF MM_MACROS_INC EQU 1

; The driver stores every pointer big-endian.
MACRO dwb
	REPT _NARG
		db HIGH(\1), LOW(\1)
		SHIFT
	ENDR
ENDM


; Play the voice sample (bank 5) with interrupts off, then restore the APU.
Voice_Play:
	push af
	push bc
	push de
	push hl
	ld a, [wSoundEnable]
	and a
	jp z, .l559C
	ldh a, [rNR10]
	ld [wSavedNR], a
	ldh a, [rNR11]
	ld [wSavedNR+1], a
	ldh a, [rNR12]
	ld [wSavedNR+2], a
	ldh a, [rNR21]
	ld [wSavedNR+3], a
	ldh a, [rNR22]
	ld [wSavedNR+4], a
	ldh a, [rNR32]
	ld [wSavedNR+5], a
	ldh a, [rNR42]
	ld [wSavedNR+6], a
	ldh a, [rNR43]
	ld [wSavedNR+7], a
	ldh a, [rIE]
	ld [wSavedIE], a
	ldh a, [rIF]
	ld [wSavedIF], a
	xor a
	ldh [rIE], a
	ldh [rIF], a
	di
	di
	di
	rst $20 ; far call
	dw Voice_PlaySample
	db BANK(Voice_PlaySample)
	ei
	ld a, [wSavedIF]
	ldh [rIF], a
	ld a, [wSavedIE]
	ldh [rIE], a
	ld a, [wSavedNR]
	ldh [rNR10], a
	ld a, [wSavedNR+1]
	ldh [rNR11], a
	ld a, [wSavedNR+2]
	ldh [rNR12], a
	ld a, [wSavedNR+3]
	ldh [rNR21], a
	ld a, [wSavedNR+4]
	ldh [rNR22], a
	ld a, [wSavedNR+5]
	ldh [rNR32], a
	ld a, [wSavedNR+6]
	ldh [rNR42], a
	ld a, [wSavedNR+7]
	ldh [rNR43], a
	xor a
	ldh [rNR30], a
	ld hl, MusicWave
	ld bc, _AUD3WAVERAM
.l5588:
	ld a, [hli]
	ld [bc], a
	inc bc
	bit 6, c
	jr z, .l5588
	ld a, $80
	ldh [rNR30], a
.l5593:
	xor a
	ld [wVoiceRequest], a
	pop hl
	pop de
	pop bc
	pop af
	ret
.l559C:
	ldh a, [rIE]
	ld [wSavedIE], a
	ldh a, [rIF]
	ld [wSavedIF], a
	xor a
	ldh [rIE], a
	ldh [rIF], a
	di
	di
	di
	rst $20 ; far call
	dw Voice_Silent
	db BANK(Voice_Silent)
	ei
	ld a, [wSavedIF]
	ldh [rIF], a
	ld a, [wSavedIE]
	ldh [rIE], a
	jr .l5593

; Far entry: start wSong (the game writes wSong first).

; =============================================================================
; Animorphs (GBC) - sound driver disassembly
; ROM: "Animorphs (E) (M5) [C][!].gbc"  (MBC5+RAM+battery, 1 MB)
;
; The driver is the playback routine of Jeremy Evers' "F.A." tracker
; (credited in-game as "music system and additional code: jeremy evers";
; music by Randy Wilson). It is the same player as tracker v0.14's bank-$10
; player, adapted for ROM songs: banked song table, 30 Hz update, sample
; playback stubbed out.
;
; Rebuilds byte-exact with RGBDS 0.9.1:
;   rgbasm -o snd.o Animorphs_SoundDriver.asm
;   rgblink -p 0xFF -o snd.gbc snd.o
; then compare 00:05B2-062A, 00:0649-0654, banks 09-0E whole, 0F:6990-7FFF.
; Generated by tools/mkasm.py; comments in tools/comments.py.
; =============================================================================

INCLUDE "hardware.inc"

; ---- game-side symbols used by the driver ----------------------------------
DEF hCurBank        EQU $FF86   ; shadow of the current ROM bank
DEF hSamplePlaying  EQU $FF89   ; tracker leftover: CH3 busy with a sample (always 0 here)
DEF MBC5_ROMB0      EQU $2666   ; ROM bank select address the game uses
DEF wSndTickToggle  EQU $C320   ; VBlank toggles this; SndUpdate runs when it is 1

; ---- driver globals ($CA00-$CA2F) ------------------------------------------
DEF wSongNum        EQU $CA00   ; song being played (index into SongPtrTable)
DEF wSongBank       EQU $CA01   ; ROM bank holding that song
DEF wPatTable       EQU $CA02   ; (2) absolute address of the pattern table
DEF wSeqPtr         EQU $CA04   ; (2) next sequence byte
DEF wTickAcc        EQU $CA06   ; row accumulator: a row happens when it overflows
DEF wSpeed2         EQU $CA07   ; song speed * 2
DEF wSongTranspose  EQU $CA08   ; signed semitones (sequence FD)
DEF wCurChan        EQU $CA09   ; low byte of the channel struct being processed
DEF wShuffleRate    EQU $CA0A   ; shuffle rate * 2 (index into ShuffleRateTable)
DEF wShufflePtr     EQU $CA0B   ; (2) -> ShuffleTable[depth*16 + phase>>8]
DEF wShufflePhase   EQU $CA0D   ; (2) 12-bit shuffle phase
DEF wSeqAdvance     EQU $CA0F   ; bit 0: a channel hit FF, read the sequence
DEF wCh3Reload      EQU $CA10   ; nonzero: force CH3 wave reload+retrigger (never set)
DEF wMixStep        EQU $CA11   ; D7 resample step (temporary)
DEF wSampleNum      EQU $CA12   ; last DC sample number (stubbed)
DEF wWaveBuf        EQU $CA20   ; (16) working CH3 waveform

; ---- channel structures ($34 bytes each) -----------------------------------
DEF wCh1            EQU $CA30
DEF wCh2            EQU $CA64
DEF wCh3            EQU $CA98
DEF wCh4            EQU $CACC
DEF CH_PTR          EQU $00     ; (2) stream pointer
DEF CH_PITCH        EQU $02     ; (2) current pitch ($4000 + note*$80), slides with portamento
DEF CH_PORTA_TGT    EQU $04     ; (2) portamento target pitch
DEF CH_NOTE_PITCH   EQU $06     ; (2) pitch of the last note (restored by retrigger)
DEF CH_PAN          EQU $08     ; this channel's NR51 bits
DEF CH_NRX1         EQU $09     ; NRx1 shadow (duty | length; CH3: length)
DEF CH_NRX2         EQU $0A     ; NRx2 shadow (envelope; CH3: NR32 level)
DEF CH_CTRL         EQU $0B     ; b7 trigger on next freq write, b6 length enable,
                                ; b1 sample active (CH3), b0 glissando (CH4: 7-bit LFSR)
DEF CH_NR10         EQU $0C     ; NR10 shadow (CH1)
DEF CH_TRANSPOSE    EQU $0D     ; effective transpose = base + arpeggio step
DEF CH_BASE_TRANSPOSE EQU $0E   ; track transpose (FD)
DEF CH_ROWS         EQU $0F     ; rows waiting to be read
DEF CH_TRIG_DELAY   EQU $10     ; E4: updates to delay each row
DEF CH_DELAY_CNT    EQU $11     ; countdown for trigger delay / retrigger
DEF CH_RETRIG       EQU $12     ; E3: retrigger period in updates (0 = off)
DEF CH_VIB_PTR      EQU $13     ; (2) VibratoTables + depth*128 + phase (b0-6 of low byte)
DEF CH_VIB_RATE     EQU $15     ; phase step per update (0 = off)
DEF CH_ARP          EQU $16     ; (2) four 4-bit arpeggio steps, current step in top nibble
DEF CH_ARP_CNT      EQU $18
DEF CH_ARP_RATE     EQU $19     ; updates per step (0 = off)
DEF CH_PORTA_RATE   EQU $1A     ; pitch units/2 per update (0 = off)
DEF CH_FINE         EQU $1B     ; signed fine tune, units of 1/64 semitone
DEF CH_APAN         EQU $1C     ; four 2-bit pan steps (00 off, 01 R, 10 L, 11 C)
DEF CH_APAN_RATE    EQU $1D
DEF CH_APAN_CNT     EQU $1E
DEF CH_APWM         EQU $1F     ; four 2-bit duty steps
DEF CH_APWM_RATE    EQU $20
DEF CH_APWM_CNT     EQU $21
DEF CH_MACRO_RET    EQU $22     ; (2) return address while inside a macro (D3)
DEF CH_WAIT         EQU $24     ; rows still to skip after an $80+n byte
DEF CH_DIRTY        EQU $27     ; b0 freq, b1 pan, b2 NRx1, b3 NRx2, b4 (unused),
                                ; b5 wave (CH3) / sweep (CH1), b7 mute (note off)

; ---- note names (note 1 = C2) ------------------------------------------------
FOR OCT, 2, 8
	DEF C_{d:OCT} EQU (OCT-2)*12 + 1
	DEF Cs{d:OCT} EQU (OCT-2)*12 + 2
	DEF D_{d:OCT} EQU (OCT-2)*12 + 3
	DEF Ds{d:OCT} EQU (OCT-2)*12 + 4
	DEF E_{d:OCT} EQU (OCT-2)*12 + 5
	DEF F_{d:OCT} EQU (OCT-2)*12 + 6
	DEF Fs{d:OCT} EQU (OCT-2)*12 + 7
	DEF G_{d:OCT} EQU (OCT-2)*12 + 8
	DEF Gs{d:OCT} EQU (OCT-2)*12 + 9
	DEF A_{d:OCT} EQU (OCT-2)*12 + 10
	DEF As{d:OCT} EQU (OCT-2)*12 + 11
	DEF B_{d:OCT} EQU (OCT-2)*12 + 12
ENDR

; ---- sequence macros -----------------------------------------------------------
MACRO seq_pattern   ; n: play pattern n
	db \1
ENDM
MACRO seq_pan       ; NR51-style byte, masked per channel
	db $FB, \1
ENDM
MACRO seq_shuffle   ; phase, depth<<4 | rate
	db $FC, \1, \2
ENDM
MACRO seq_transpose ; signed semitones for the whole song
	db $FD, \1
ENDM
MACRO seq_speed
	db $FE, \1
ENDM
MACRO seq_loop      ; restart the song from its first sequence byte
	db $FF
ENDM

; ---- stream macros ---------------------------------------------------------------
; A row is ended by a note, note_off, empty_row or wait. Commands ($C0-$FF)
; are read in the same row until one of those.
MACRO note          ; CH1-3: note 1-72 (C2-B7)
	db \1
ENDM
MACRO noise         ; CH4: noise index 1-63, 15-bit LFSR
	db \1
ENDM
MACRO noise7        ; CH4: noise index 0-63, 7-bit LFSR
	db $40 | \1
ENDM
MACRO note_off      ; mute the channel in NR51 and end the row
	db $00
ENDM
MACRO empty_row     ; CH1-3 bytes $49-$7F: end the row, nothing else
	db \1
ENDM
MACRO wait          ; end this row and skip n more
	db $80 | \1
ENDM
MACRO call_macro    ; target, pattern table label (offset is relative to it)
	db $D3
	dw \1 - \2
ENDM
MACRO auto_pwm      ; steps (4x2 bits), rate        [CH1/2]
	db $D4, \1, \2
ENDM
MACRO auto_pan      ; steps (4x2 bits), rate
	db $D5, \1, \2
ENDM
MACRO wave_dist     ; type<<4 | gain                [CH3]
	db $D6, \1
ENDM
MACRO wave_mix      ; preset, resample step         [CH3]
	db $D7, \1, \2
ENDM
MACRO stop_sample   ; no-op in this game            [CH3]
	db $D8
ENDM
MACRO reset_vib     ; vibrato phase = 0
	db $D9
ENDM
MACRO wave_preset   ; load preset into wWaveBuf     [CH3]
	db $DA, \1
ENDM
MACRO fine_tune     ; signed, $40 = +1 semitone     [CH1-3]
	db $DB, \1
ENDM
MACRO play_sample   ; stubbed in this game          [CH3]
	db $DC, \1
ENDM
MACRO arpeggio      ; steps 1-2, steps 3-4, rate
	db $DD, \1, \2, \3
ENDM
MACRO glissando     ; 0 off / nonzero on (round pitch to semitones)
	db $DE, \1
ENDM
MACRO porta_src     ; note to slide the next note from
	db $DF, \1
ENDM
MACRO porta_rate    ; 0 = off
	db $E0, \1
ENDM
MACRO vibrato       ; depth 0-$1F, rate ($40 fastest, >$40 runs backwards)
	db $E1, \1, \2
ENDM
MACRO restart_env   ; retrigger on the next frequency write
	db $E2
ENDM
MACRO retrig_delay  ; retrigger every n updates (0 = off)
	db $E3, \1
ENDM
MACRO trig_delay    ; delay each row by n updates
	db $E4, \1
ENDM
MACRO use_duration  ; 0 = infinite, else NRx4 length enable
	db $E5, \1
ENDM
MACRO sweep         ; NR10 value                    [CH1]
	db $E6, \1
ENDM
MACRO env_volume    ; NRx2 high nibble (CH3: NR32 value)
	db $E7, \1
ENDM
MACRO env_rate      ; NRx2 low nibble (dir|rate) (CH3: NR32 value)
	db $E8, \1
ENDM
MACRO duration      ; NRx1 length bits (CH3: NR31)
	db $E9, \1
ENDM
MACRO duty          ; NRx1 duty bits ($00/$40/$80/$C0) [CH1/2]
	db $EA, \1
ENDM
MACRO pan           ; NR51-style byte, masked for this channel
	db $FB, \1
ENDM
MACRO shuffle       ; same as seq_shuffle
	db $FC, \1, \2
ENDM
MACRO transpose     ; signed track transpose
	db $FD, \1
ENDM
MACRO speed
	db $FE, \1
ENDM
MACRO end_pattern   ; end of pattern (or return from macro)
	db $FF
ENDM

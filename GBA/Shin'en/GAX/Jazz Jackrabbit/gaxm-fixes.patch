+        /// <summary>Indices of at most <paramref name="max"/> envelope points: first, last, sustain and
+        /// loop points are kept, then the interior point whose removal changes the curve least is
+        /// dropped until the envelope fits.</summary>
+        private static int[] ReduceEnvelope(GAX_InstrumentEnvelope env, int max) {
+            var idx = Enumerable.Range(0, env.NumPoints).ToList();
+            if (idx.Count <= max) return idx.ToArray();
+            var pinned = new HashSet<int> { 0, env.NumPoints - 1 };
+            if (env.Sustain.HasValue) pinned.Add(env.Sustain.Value);
+            if (env.LoopStart.HasValue) pinned.Add(env.LoopStart.Value);
+            if (env.LoopEnd.HasValue) pinned.Add(env.LoopEnd.Value);
+            while (idx.Count > max) {
+                int best = -1; double bestErr = double.MaxValue;
+                for (int k = 1; k < idx.Count - 1; k++) {
+                    if (pinned.Contains(idx[k])) continue;
+                    var a = env.Points[idx[k - 1]]; var b = env.Points[idx[k]]; var c = env.Points[idx[k + 1]];
+                    double t = (c.X == a.X) ? 0 : (b.X - a.X) / (double)(c.X - a.X);
+                    double err = Math.Abs(a.Y + (c.Y - a.Y) * t - b.Y);
+                    if (err < bestErr) { bestErr = err; best = k; }
+                }
+                if (best < 0) break;
+                idx.RemoveAt(best);
+            }
+            if (idx.Count > max) idx = idx.Take(max - 1).Concat(new[] { env.NumPoints - 1 }).ToList();
+            return idx.ToArray();
+        }
